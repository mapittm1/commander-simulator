# Preserve exact reviewed bytes used by engine build checksums.
engine/patches/*.patch -text whitespace=-blank-at-eol,cr-at-eol
engine/tests/*.java -text whitespace=cr-at-eol
engine/sticker_recipe.json -text whitespace=cr-at-eol
# Evidence hashes bind exact bytes; fixed native witness source uses portable LF.
engine/native_test_evidence.json -text whitespace=cr-at-eol
engine/history_state_evidence.json -text whitespace=cr-at-eol
tests/support/history_worker.py text eol=lf
tests/integration/test_history_integration.py text eol=lf
engine/damage_state_evidence.json -text whitespace=cr-at-eol
tests/support/damage_worker.py text eol=lf
tests/integration/test_damage_integration.py text eol=lf
engine/participant_state_evidence.json -text whitespace=cr-at-eol
tests/support/participant_worker.py text eol=lf
tests/integration/test_participant_integration.py text eol=lf
engine/starting_life_evidence.json -text whitespace=cr-at-eol
tests/support/starting_life_worker.py text eol=lf
tests/integration/test_starting_life_integration.py text eol=lf
# Activation evidence binds lock bytes; use portable LF on every checkout.
config/engine_lock.json text eol=lf
config/engine_locks/*.json text eol=lf

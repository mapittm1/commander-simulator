@@ -0,0 +1,25 @@
+package forge.game;
+
+import forge.game.card.Card;
+import forge.game.spellability.SpellAbilitySnapshot;
+import java.util.Objects;
+
+/** Remove a temporary effect in its own game without retaining a source-world closure. */
+public final class ExileEffectCommand implements SnapshotCommand {
+    private static final long serialVersionUID = 1L;
+    private final Card effect;
+
+    public ExileEffectCommand(Card effect) {
+        this.effect = Objects.requireNonNull(effect, "Effect card");
+    }
+
+    @Override
+    public void run() {
+        effect.getGame().getAction().exileEffect(effect);
+    }
+
+    @Override
+    public SnapshotCommand copyForSnapshot(SpellAbilitySnapshot context) {
+        return new ExileEffectCommand(context.map(effect));
+    }
+}

@@ -0,0 +1,35 @@
+package forge.ai.ability;
+
+import com.google.common.collect.Iterables;
+import forge.ai.AiAbilityDecision;
+import forge.ai.ComputerUtilCard;
+import forge.ai.SpellAbilityAi;
+import forge.ai.simulation.PaidOutcomePlanner;
+import forge.game.card.Card;
+import forge.game.card.CardLists;
+import forge.game.card.CardPredicates;
+import forge.game.card.CounterEnumType;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import java.util.Map;
+
+/** Evaluate paid empower outcomes with native token and counter replacements. */
+public final class EmpowerAi extends SpellAbilityAi {
+    @Override
+    protected AiAbilityDecision checkApiLogic(Player actor, SpellAbility action) {
+        return PaidOutcomePlanner.choose(actor, action.getRootAbility());
+    }
+
+    @Override
+    public AiAbilityDecision chkDrawback(Player actor, SpellAbility action) {
+        return PaidOutcomePlanner.choose(actor, action.getRootAbility());
+    }
+
+    @Override
+    protected Card chooseSingleCard(Player actor, SpellAbility action, Iterable<Card> options,
+            boolean optional, Player targetedPlayer, Map<String, Object> params) {
+        Iterable<Card> eligible = CardLists.filter(options,
+                CardPredicates.canReceiveCounters(CounterEnumType.LOYALTY));
+        return ComputerUtilCard.getBestAI(Iterables.isEmpty(eligible) ? options : eligible);
+    }
+}

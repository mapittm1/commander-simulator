diff --git a/forge-ai/src/main/java/forge/ai/simulation/MassTapChoices.java b/forge-ai/src/main/java/forge/ai/simulation/MassTapChoices.java
new file mode 100644
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/simulation/MassTapChoices.java
@@ -0,0 +1,148 @@
+package forge.ai.simulation;
+
+import forge.ai.AiCache;
+import forge.ai.ComputerUtilCard;
+import forge.game.Game;
+import forge.game.ability.ApiType;
+import forge.game.card.Card;
+import forge.game.card.CardCollection;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+import forge.util.AITimeoutTracker;
+import forge.util.MyRandom;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+import java.util.Random;
+
+/** Native mass-tap choices, bounded paid variants and paired local resolution policy. */
+public final class MassTapChoices {
+    private static final int MAX_TYPES = 32;
+    private static final int MAX_VARIANTS = 128;
+    private static final ThreadLocal<Boolean> ASSESSING = ThreadLocal.withInitial(() -> false);
+    private static final ThreadLocal<Branch> FORCED = new ThreadLocal<>();
+    private record Branch(SpellAbility action, boolean tap) { }
+    private record Outcome(long value, long available, long resources) { }
+    private MassTapChoices() { }
+
+    private static int position(SpellAbility action) {
+        int index = 0;
+        for (SpellAbility part = action.getRootAbility(); part != null; part = part.getSubAbility(), index++) {
+            if (part == action) return index;
+        }
+        return -1;
+    }
+
+    public static boolean supportsType(SpellAbility action) {
+        if (action.getApi() != ApiType.ChooseType || !"Card".equals(action.getParam("Type"))
+                || !action.hasParam("ValidTypes") || action.hasParam("AtRandom") || action.hasParam("Note")
+                || action.hasParam("Secretly") || action.hasParam("ChooseType2")) return false;
+        for (SpellAbility part = action.getSubAbility(); part != null; part = part.getSubAbility()) {
+            if (part.getApi() == ApiType.TapOrUntapAll) return true;
+        }
+        return false;
+    }
+
+    public static List<String> typeTokens(SpellAbility action, Collection<String> options) {
+        int index = position(action);
+        if (!supportsType(action) || index < 0 || options.isEmpty() || options.size() > MAX_TYPES) return List.of();
+        List<String> result = new ArrayList<>();
+        for (String type : options) result.add("mass-type:" + index + ":" + type);
+        return result;
+    }
+
+    public static List<String> directionTokens(SpellAbility action) {
+        int index = position(action);
+        return action.getApi() != ApiType.TapOrUntapAll || index < 0 ? List.of()
+                : List.of("mass-direction:" + index + ":tap", "mass-direction:" + index + ":untap");
+    }
+
+    /** An oversized domain retains native policy instead of silently searching a prefix. */
+    public static List<SpellAbility> variants(SpellAbility action) {
+        List<List<String>> sequences = new ArrayList<>(); sequences.add(List.of());
+        for (SpellAbility part = action; part != null; part = part.getSubAbility()) {
+            List<String> options;
+            if (supportsType(part)) {
+                List<String> types = new ArrayList<>(List.of(part.getParam("ValidTypes").split(",")));
+                if (part.hasParam("InvalidTypes")) types.removeAll(List.of(part.getParam("InvalidTypes").split(",")));
+                options = typeTokens(part, types);
+                if (options.isEmpty()) return List.of(action);
+            } else if (part.getApi() == ApiType.TapOrUntapAll) {
+                options = directionTokens(part);
+            } else {
+                // Other resolution-time choices belong to their existing native policy.
+                return List.of(action);
+            }
+            if (options.isEmpty() || sequences.size() * options.size() > MAX_VARIANTS) return List.of(action);
+            List<List<String>> next = new ArrayList<>();
+            for (List<String> prefix : sequences) for (String option : options) {
+                AITimeoutTracker.check();
+                List<String> sequence = new ArrayList<>(prefix); sequence.add(option); next.add(sequence);
+            }
+            sequences = next;
+        }
+        List<SpellAbility> result = new ArrayList<>();
+        for (List<String> sequence : sequences) {
+            SpellAbility candidate = action.copy();
+            if (TextChangeChoices.stageFullWords(candidate, sequence)) result.add(candidate);
+        }
+        return result;
+    }
+
+    /** Project only the not-yet-applied mass effect, never replay an already resolving parent. */
+    public static Boolean chooseDirection(Player actor, SpellAbility action) {
+        if (action.getApi() != ApiType.TapOrUntapAll) return null;
+        Branch forced = FORCED.get();
+        if (forced != null && forced.action == action) return forced.tap;
+        if (ASSESSING.get()) return null;
+        ASSESSING.set(true);
+        try {
+            Outcome tap = project(actor, action, true), untap = project(actor, action, false);
+            if (tap.value != untap.value) return tap.value > untap.value;
+            if (tap.available != untap.available) return tap.available > untap.available;
+            return tap.resources >= untap.resources;
+        } finally {
+            ASSESSING.remove();
+        }
+    }
+
+    private static Outcome project(Player actor, SpellAbility action, boolean tap) {
+        long value = 0, available = 0, resources = 0;
+        for (long seed : new long[]{0L, 4096L}) {
+            AITimeoutTracker.check();
+            Outcome result = AiCache.withIsolatedCache(() -> MyRandom.withRandom(new Random(seed), () -> {
+                GameCopier copier = new GameCopier(actor.getGame());
+                Game game = copier.makeCopy(null, actor);
+                Player copiedActor = copier.find(actor), beneficiary = copier.find(DecisionPerspective.beneficiary(actor));
+                SpellAbility copied = copier.find(action);
+                Branch previous = FORCED.get(); FORCED.set(new Branch(copied, tap));
+                try {
+                    copied.getApi().getSpellEffect().resolve(copied);
+                } finally {
+                    if (previous == null) FORCED.remove(); else FORCED.set(previous);
+                }
+                Player resolver = copiedActor.getWeakestOpponent();
+                GameSimulator.resolveStack(game, resolver == null ? copiedActor : resolver);
+                GameStateEvaluator.Score score = new GameStateEvaluator().getScoreForGameState(game, beneficiary);
+                return new Outcome(score.value, score.availableValue, untappedResources(game, beneficiary));
+            }));
+            value += result.value; available += result.available; resources += result.resources;
+        }
+        return new Outcome(value, available, resources);
+    }
+
+    /** Tie-break only: retaining usable public permanents is preferable when native scores agree. */
+    private static long untappedResources(Game game, Player beneficiary) {
+        long total = 0;
+        for (Card card : game.getCardsIn(ZoneType.Battlefield)) {
+            AITimeoutTracker.check();
+            if (card.isTapped() || card.isPhasedOut() || !(card.isCreature() || card.isLand() || card.isArtifact())) continue;
+            int value = Math.max(1, card.isCreature() ? ComputerUtilCard.evaluateCreature(card)
+                    : ComputerUtilCard.evaluatePermanentList(new CardCollection(card)));
+            boolean friendly = card.getController() == beneficiary || beneficiary.getAllies().contains(card.getController());
+            total += friendly ? value : -value;
+        }
+        return total;
+    }
+}

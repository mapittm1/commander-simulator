diff --git a/forge-ai/src/main/java/forge/ai/simulation/ModalTextChoices.java b/forge-ai/src/main/java/forge/ai/simulation/ModalTextChoices.java
new file mode 100644
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/simulation/ModalTextChoices.java
@@ -0,0 +1,166 @@
+package forge.ai.simulation;
+
+import forge.game.GameObject;
+import forge.game.ability.AbilityUtils;
+import forge.game.ability.ApiType;
+import forge.game.ability.effects.CharmEffect;
+import forge.game.player.Player;
+import forge.game.spellability.AbilitySub;
+import forge.game.spellability.SpellAbility;
+import forge.util.AITimeoutTracker;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Function;
+
+/** Bounded mode preparation and replay for paid outcomes containing text changes. */
+public final class ModalTextChoices {
+    private static final String MODES = "AITextModes";
+    private static final String OWNER = "AITextModesOwner";
+    private static final int MAX_MODES = 32;
+    private static final int MAX_VARIANTS = 128;
+
+    private ModalTextChoices() { }
+
+    public static boolean supports(SpellAbility action) {
+        if (action.getActivatingPlayer() == null || action.hasParam("Random")
+                || action.hasParam("AtRandom") || action.hasParam("NumRandomChoices")
+                || action.hasParam("Chooser") || action.hasParam("CanRepeatModes")) return false;
+        if (action.getApi() == ApiType.GenericChoice
+                && (!"You".equals(action.getParam("Defined"))
+                    || !"1".equals(action.getParamOrDefault("ChoiceAmount", "1")))) return false;
+        if (action.getApi() != ApiType.Charm && action.getApi() != ApiType.GenericChoice) return false;
+        List<AbilitySub> choices = action.getAdditionalAbilityList("Choices");
+        return choices != null && !choices.isEmpty() && choices.size() <= MAX_MODES
+                && choices.stream().anyMatch(ModalTextChoices::containsText);
+    }
+
+    private static boolean containsText(SpellAbility action) {
+        for (SpellAbility part = action; part != null; part = part.getSubAbility()) {
+            if (part.getApi() == ApiType.ChangeText) return true;
+        }
+        return false;
+    }
+
+    static List<SpellAbility> variants(SpellAbility action) {
+        if (!supports(action)) return List.of(action.copy());
+        SpellAbility prepared = action.copy();
+        List<AbilitySub> all = prepared.getAdditionalAbilityList("Choices");
+        List<AbilitySub> legal = prepared.getApi() == ApiType.Charm
+                ? CharmEffect.makePossibleOptions(prepared) : all;
+        int max = prepared.getApi() == ApiType.GenericChoice ? 1
+                : prepared.isEntwine() ? legal.size()
+                : AbilityUtils.calculateAmount(prepared.getHostCard(), prepared.getParamOrDefault("CharmNum", "1"), prepared);
+        int min = prepared.isEntwine() ? max : prepared.getApi() == ApiType.GenericChoice ? 1
+                : AbilityUtils.calculateAmount(prepared.getHostCard(), prepared.getParamOrDefault("MinCharmNum", String.valueOf(max)), prepared);
+        if (min < 0 || max < min || max > MAX_MODES) return List.of();
+        List<Integer> indices = new ArrayList<>();
+        for (int i = 0; i < all.size(); i++) if (legal.contains(all.get(i))) indices.add(i);
+        List<List<Integer>> combinations = new ArrayList<>();
+        combine(indices, 0, min, Math.min(max, indices.size()), new ArrayList<>(), combinations);
+        List<SpellAbility> result = new ArrayList<>();
+        for (List<Integer> selected : combinations) {
+            SpellAbility variant = action.copy();
+            variant.setPlannedAiChoice(MODES, selected.stream().map(String::valueOf).collect(java.util.stream.Collectors.joining(",")));
+            variant.setPlannedAiChoice(OWNER, String.valueOf(action.getActivatingPlayer().getId()));
+            if (variant.getApi() == ApiType.Charm) {
+                List<AbilitySub> chosen = new ArrayList<>();
+                for (int index : selected) chosen.add(variant.getAdditionalAbilityList("Choices").get(index));
+                variant.setChosenList(chosen);
+                variant.setSubAbility(null);
+                CharmEffect.chainAbilities(variant, chosen);
+            }
+            result.add(variant);
+        }
+        return result;
+    }
+
+    private static void combine(List<Integer> options, int start, int min, int max,
+            List<Integer> selected, List<List<Integer>> result) {
+        AITimeoutTracker.check();
+        // A branch with too few remaining modes cannot produce a legal combination.
+        // Without this guard an all-mode form explores every impossible subset.
+        if (result.size() >= MAX_VARIANTS || selected.size() + options.size() - start < min) return;
+        if (selected.size() >= min) result.add(List.copyOf(selected));
+        if (selected.size() == max) return;
+        for (int i = start; i < options.size() && result.size() < MAX_VARIANTS; i++) {
+            selected.add(options.get(i));
+            combine(options, i + 1, min, max, selected, result);
+            selected.remove(selected.size() - 1);
+        }
+    }
+
+    private static List<Integer> indices(SpellAbility action) {
+        String value = action.getPlannedAiChoice(MODES);
+        if (value == null || value.isEmpty() || value.length() > 128) return List.of();
+        List<Integer> result = new ArrayList<>();
+        try {
+            for (String token : value.split(",")) {
+                int index = Integer.parseInt(token);
+                if (index < 0 || index >= action.getAdditionalAbilityList("Choices").size()
+                        || result.contains(index)) return List.of();
+                result.add(index);
+            }
+        } catch (NumberFormatException exception) { return List.of(); }
+        return result;
+    }
+
+    static SpellAbility genericChild(SpellAbility action) {
+        List<Integer> selected = indices(action);
+        return action.getApi() == ApiType.GenericChoice && selected.size() == 1
+                ? action.getAdditionalAbilityList("Choices").get(selected.get(0)) : null;
+    }
+
+    public static SpellAbility plannedGeneric(Player actor, SpellAbility action, List<SpellAbility> available) {
+        if (!supports(action) || !action.getHostCard().getGame().getStack().isResolving()
+                || !String.valueOf(actor.getId()).equals(action.getPlannedAiChoice(OWNER))) return null;
+        SpellAbility selected = genericChild(action);
+        return selected != null && available.contains(selected) ? selected : null;
+    }
+
+    /** Stable ordinal tokens distinguish resolution-time modes from literal word choices. */
+    public static List<String> resolutionModes(SpellAbility action, List<SpellAbility> available) {
+        if (action.getApi() != ApiType.GenericChoice) return List.of();
+        List<AbilitySub> all = action.getAdditionalAbilityList("Choices");
+        if (all == null || all.size() > MAX_MODES) return List.of();
+        List<String> result = new ArrayList<>();
+        for (SpellAbility choice : available) {
+            int index = all.indexOf(choice);
+            if (index < 0) return List.of();
+            result.add("mode:" + index);
+        }
+        return result;
+    }
+
+    static void copyChoices(SpellAbility source, SpellAbility destination,
+            Function<GameObject, GameObject> mapper) {
+        for (String key : List.of(MODES, OWNER)) destination.clearPlannedAiChoice(key);
+        String encoded = source.getPlannedAiChoice(MODES);
+        if (encoded == null || source.getApi() != destination.getApi()) return;
+        List<Integer> selected = indices(source);
+        if (selected.isEmpty() && (!encoded.isEmpty() || source.getApi() != ApiType.Charm)) return;
+        List<AbilitySub> from = source.getAdditionalAbilityList("Choices");
+        List<AbilitySub> to = destination.getAdditionalAbilityList("Choices");
+        if (from == null || to == null || from.size() != to.size()) return;
+        if (source.getApi() == ApiType.Charm && !selected.isEmpty() && source.getSubAbility() == null) return;
+        destination.setPlannedAiChoice(MODES, encoded);
+        if (source.getPlannedAiChoice(OWNER) != null)
+            destination.setPlannedAiChoice(OWNER, source.getPlannedAiChoice(OWNER));
+        if (source.getApi() == ApiType.GenericChoice) {
+            for (int index : selected) SpellAbilityChoiceCopier.copyTargets(from.get(index), to.get(index), mapper);
+        } else if (source.getApi() == ApiType.Charm) {
+            List<AbilitySub> modes = new ArrayList<>();
+            SpellAbility part = source.getSubAbility();
+            for (int index : selected) {
+                AbilitySub mode = to.get(index);
+                SpellAbilityChoiceCopier.copyTargets(part, mode, mapper);
+                for (SpellAbility original = from.get(index); original != null; original = original.getSubAbility()) {
+                    if (part != null) part = part.getSubAbility();
+                }
+                modes.add(mode);
+            }
+            destination.setChosenList(modes);
+            destination.setSubAbility(null);
+            CharmEffect.chainAbilities(destination, modes);
+        }
+    }
+}

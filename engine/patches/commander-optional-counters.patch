+    @Override
+    public boolean canChooseOptionalAction(final SpellAbility sa) {
+        if (!sa.hasParam("ValidCards") || !sa.hasParam("CounterType") || sa.getSubAbility() != null
+                || sa.hasParam("UnlessCost") || sa.hasParam("Placer") || sa.hasParam("AmountByChosenMap")

+            return true;
+        }
+        final ZoneType zone = sa.hasParam("ValidZone")
+                ? ZoneType.smartValueOf(sa.getParam("ValidZone")) : ZoneType.Battlefield;
+        CardCollectionView cards = CardLists.getValidCards(activator.getGame().getCardsIn(zone),
+                sa.getParam("ValidCards"), activator, host, sa);
+        if (sa.usesTargeting()) {
+            final Player target = sa.getTargets().getFirstTargetedPlayer();
+            if (target == null) {
+                return true;
+            }
+            cards = CardLists.filterControlledBy(cards, target);
+        }
+        // Match native admission; replacements are applied only during actual placement.
+        for (Card card : cards) {
+            if (card.canReceiveCounters(type, null)) {
+                return true;
+            }
+        }
+        return false;
+    }
 

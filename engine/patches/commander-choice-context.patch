+    /** Copy announced choices after entity maps exist, preserving their public presentation. */
+    public void copySnapshotChoicesFrom(Card original, IEntityMap map) {
+        chosenType = original.chosenType;
+        chosenType2 = original.chosenType2;
+        chosenCommanderColor = original.chosenCommanderColor;
+        chosenColors = copyChoiceStrings(original.chosenColors);
+        chosenName = copyChoiceStrings(original.chosenName);
+        chosenPlayer = map.map(original.chosenPlayer);
+        chosenEvenOdd = original.chosenEvenOdd;
+        chosenDirection = original.chosenDirection;
+        chosenMode = original.chosenMode;
+        chosenSector = original.chosenSector;
+        chosenCards = original.chosenCards == null ? null : map.mapCollection(original.getChosenCards());
+        chosenMap = Maps.newHashMap();
+        for (Map.Entry<Player, CardCollection> entry : original.chosenMap.entrySet()) {
+            chosenMap.put(map.map(entry.getKey()), entry.getValue() == null ? null : map.mapCollection(entry.getValue()));
+        }
+        copySnapshotNumberFrom(original);
+
+        // A secret change can leave an older public choice visible. Copy that view separately.
+        view.set(TrackableProperty.ChosenType, original.view.getChosenType());
+        view.set(TrackableProperty.ChosenType2, original.view.getChosenType2());
+        List<String> publicColors = original.view.getChosenColors();
+        view.set(TrackableProperty.ChosenColors, publicColors == original.chosenColors
+                ? chosenColors : copyChoiceStrings(publicColors));
+        List<String> publicNames = original.view.getNamedCard();
+        view.set(TrackableProperty.NamedCard, publicNames == original.chosenName
+                ? chosenName : copyChoiceStrings(publicNames));
+        forge.game.player.PlayerView publicPlayer = original.view.getChosenPlayer();
+        Player presented = publicPlayer == null ? null : original.getGame().getPlayer(publicPlayer.getId());
+        view.set(TrackableProperty.ChosenPlayer, forge.game.player.PlayerView.get(map.map(presented)));
+        view.set(TrackableProperty.ChosenDirection, original.view.getChosenDirection());
+        view.set(TrackableProperty.ChosenEvenOdd, original.view.getChosenEvenOdd());
+        view.set(TrackableProperty.ChosenMode, original.view.getChosenMode());
+        view.set(TrackableProperty.ChosenCards, chosenCards == null ? null : CardView.getCollection(chosenCards));
+    }
+
+    private static List<String> copyChoiceStrings(List<String> values) {
+        return values == null ? null : Lists.newArrayList(values);
+    }
+

+    public boolean canChooseOptionalAction(final SpellAbility sa) {
+        if (sa.hasParam("UnlessCost") || sa.hasParam("Upto")
+                || (sa.getSubAbility() != null && !"Draw".equals(sa.getParam("OptionalAction")))) {
+            return true;
+        }
+        int amount = sa.hasParam("NumCards")
+                ? AbilityUtils.calculateAmount(sa.getHostCard(), sa.getParam("NumCards"), sa) : 1;
+        List<Player> players = getTargetPlayersWithDuplicates(true, "Defined", sa);
+        // The entire optional amount must be legal; library size is not a prohibition.
+        for (Player player : Sets.newLinkedHashSet(players)) {
+            if (player.isInGame() && player.canDraw(amount * Collections.frequency(players, player))) {
+                return true;
+            }
+        }
+        return false;
+    }

 public class LookAtEffect extends SpellAbilityEffect {
+    private enum LibraryPosition { TOP, BOTTOM, UNKNOWN }
 
     @Override
     public void resolve(final SpellAbility sa) {
-        sa.getHostCard().getGame().getAction().revealTo(getTargetCards(sa), sa.getActivatingPlayer());
+        CardCollection cards = getTargetCards(sa);
+        Player observer = sa.getActivatingPlayer();
+        sa.getHostCard().getGame().getAction().revealTo(cards, observer);
+        LibraryPosition position = disclosedLibraryPosition(sa);
+        if (position == LibraryPosition.UNKNOWN) return;
+        for (Card card : cards) {
+            if (!card.isInZone(ZoneType.Library)) continue;
+            Player owner = card.getOwner();
+            int index = position == LibraryPosition.TOP ? 0 : owner.getCardsIn(ZoneType.Library).size() - 1;
+            // The memory callback validates the current incarnation and library revision.
+            observer.getController().observeLibraryTop(owner, Map.of(index, card));
+        }
+    }
+
+    private static LibraryPosition disclosedLibraryPosition(SpellAbility action) {
+        String[] definition = action.getParamOrDefault("Defined", "").trim().split("\\s+", 2);
+        if (definition.length != 2 || !definition[0].equals("ValidAll") || definition[1].contains(","))
+            return LibraryPosition.UNKNOWN;
+        int separator = definition[1].indexOf('.');
+        if (separator < 0) return LibraryPosition.UNKNOWN;
+        List<String> properties = List.of(definition[1].substring(separator + 1).split("\\+"));
+        boolean top = properties.contains("TopLibrary"), bottom = properties.contains("BottomLibrary");
+        // Filtered forms such as TopLibrary_Creature reveal identity, not absolute position.
+        if (!top && !bottom) return LibraryPosition.UNKNOWN;
+        return top ? LibraryPosition.TOP : LibraryPosition.BOTTOM;
     }
 

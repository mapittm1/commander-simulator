+    /** Preview mana while reserving cards already allocated to another part of the payment. */
+    public static boolean canPayManaCostWithReservedCards(ManaCostBeingPaid cost, SpellAbility sa,
+            Player payer, boolean effect, Set<Card> reservedCards) {
+        return previewManaPayment(cost, sa, payer, effect, reservedCards) != null;
+    }
+
+    /** Return a native mana allocation without spending resources or retaining preview memories. */
+    public static CardCollection getManaSourcesWithReservedCards(ManaCostBeingPaid cost, SpellAbility sa,
+            Player payer, boolean effect, Set<Card> reservedCards) {
+        List<SpellAbility> payment = previewManaPayment(cost, sa, payer, effect, reservedCards);
+        return payment == null ? null : new CardCollection(payment.stream().map(SpellAbility::getHostCard));
+    }
+
+    private static List<SpellAbility> previewManaPayment(ManaCostBeingPaid cost, SpellAbility sa,
+            Player payer, boolean effect, Set<Card> reservedCards) {
+        Set<Card> taps = AiCardMemory.getMemorySet(payer, MemorySet.PAYS_TAP_COST);
+        Set<Card> sacrifices = AiCardMemory.getMemorySet(payer, MemorySet.PAYS_SAC_COST);
+        Set<ManaCostBeingPaid> unpaid = AiCardMemory.getMemorySet(payer, AiCardMemory.MemorySetMana.UNPAID_COSTS);
+        Set<Card> previousTaps = taps == null ? Set.of() : new HashSet<>(taps);
+        Set<Card> previousSacrifices = sacrifices == null ? Set.of() : new HashSet<>(sacrifices);
+        Set<ManaCostBeingPaid> previousUnpaid = unpaid == null ? Set.of() : new HashSet<>(unpaid);
+        try {
+            return payManaCost(new ManaCostBeingPaid(cost), sa, payer, true, true, effect,
+                    Set.copyOf(reservedCards));
+        } finally {
+            restorePreviewMemory(taps, previousTaps);
+            restorePreviewMemory(sacrifices, previousSacrifices);
+            restorePreviewMemory(unpaid, previousUnpaid);
+        }
+    }
+
+    private static <T> void restorePreviewMemory(Set<T> memory, Set<T> previous) {
+        if (memory != null) {
+            memory.clear();
+            memory.addAll(previous);
+        }
+    }

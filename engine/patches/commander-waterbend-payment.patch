+    /** Choose waterbend taps only when the remaining mana has an independent payment. */
+    private Map<Card, ManaCostShard> chooseWaterbendPayment(SpellAbility sa, ManaCost manaCost,
+            CardCollectionView candidates, Integer maxReduction) {
+        CardCollection ordered = new CardCollection(candidates);
+        ordered.sort(Comparator.comparing((Card card) -> !card.getManaAbilities().isEmpty())
+                .thenComparing(Card::isCreature));
+        CardCollection noncreatures = CardLists.filter(ordered, card -> !card.isCreature());
+        Map<Card, ManaCostShard> chosen = findWaterbendPayment(sa, manaCost, noncreatures, maxReduction);
+        if (chosen != null) {
+            return chosen;
+        }
+        if (noncreatures.size() != ordered.size()) {
+            chosen = findWaterbendPayment(sa, manaCost, ordered, maxReduction);
+        }
+        return chosen == null ? Collections.emptyMap() : chosen;
+    }
+
+    /** Preserve available creatures when mana can cover what noncreature taps leave unpaid. */
+    private Map<Card, ManaCostShard> findWaterbendPayment(SpellAbility sa, ManaCost manaCost,
+            CardCollection ordered, Integer maxReduction) {
+        int maximum = maxReduction == null ? manaCost.getGenericCost()
+                : Math.min(manaCost.getGenericCost(), Math.max(0, maxReduction));
+        maximum = Math.min(maximum, ordered.size());
+        for (int amount = maximum; amount >= 0; amount--) {
+            Map<Card, ManaCostShard> chosen = ComputerUtilMana.getConvokeOrImproviseFromList(
+                    ManaCost.get(amount), ordered, true, true);
+            ManaCostBeingPaid remaining = new ManaCostBeingPaid(manaCost);
+            remaining.decreaseGenericMana(chosen.size());
+            if (ComputerUtilMana.canPayManaCostWithReservedCards(remaining, sa,
+                    sa.getActivatingPlayer(), false, chosen.keySet())) {
+                return chosen;
+            }
+            // A prefix can consume mana needed for colored or ordinary costs.
+            // Also try the native mana allocation first, then validate its complement.
+            CardCollection manaSources = ComputerUtilMana.getManaSourcesWithReservedCards(remaining,
+                    sa, sa.getActivatingPlayer(), false, Set.of());
+            if (manaSources != null) {
+                CardCollection alternatives = new CardCollection(ordered);
+                alternatives.removeAll(manaSources);
+                Map<Card, ManaCostShard> alternate = ComputerUtilMana.getConvokeOrImproviseFromList(
+                        ManaCost.get(amount), alternatives, true, true);
+                if (!alternate.keySet().equals(chosen.keySet())) {
+                    ManaCostBeingPaid alternateRemainder = new ManaCostBeingPaid(manaCost);
+                    alternateRemainder.decreaseGenericMana(alternate.size());
+                    if (ComputerUtilMana.canPayManaCostWithReservedCards(alternateRemainder, sa,
+                            sa.getActivatingPlayer(), false, alternate.keySet())) {
+                        return alternate;
+                    }
+                }
+            }
+        }
+        return null;
+    }

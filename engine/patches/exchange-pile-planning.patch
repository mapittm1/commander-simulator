+    private static boolean validGroup(CardCollectionView chosen, CardCollectionView eligible,
+            Player from, Player to, ZoneType zone) {
+        java.util.Set<Card> allowed = java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<>());
+        for (Card card : eligible) allowed.add(card);
+        java.util.Set<Integer> seen = new java.util.HashSet<>();
+        for (Card card : chosen) {
+            if (card == null || card.getGame() != from.getGame() || card.getController() != from
+                    || card.getZone() == null || !card.getZone().is(zone) || card.isPhasedOut()
+                    || !allowed.contains(card) || !seen.add(card.getId()) || !card.canBeControlledBy(to)) return false;
+        }
+        return true;
+    }

@@ -0,0 +1,100 @@
+package forge.ai.ability;
+
+import forge.ai.AiAbilityDecision;
+import forge.ai.ComputerUtilCard;
+import forge.ai.SpellAbilityAi;
+import forge.ai.simulation.DecisionPerspective;
+import forge.ai.simulation.PaidOutcomePlanner;
+import forge.game.ability.AbilityUtils;
+import forge.game.card.Card;
+import forge.game.card.CardCollection;
+import forge.game.card.CardCollectionView;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+import forge.util.AITimeoutTracker;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Assess paid exchanges and choose both equal-sized creature groups together. */
+public final class ControlExchangeVariantAi extends SpellAbilityAi {
+    @Override
+    protected AiAbilityDecision checkApiLogic(Player actor, SpellAbility action) {
+        return PaidOutcomePlanner.choose(actor, action.getRootAbility());
+    }
+
+    @Override
+    public AiAbilityDecision chkDrawback(Player actor, SpellAbility action) {
+        return PaidOutcomePlanner.choose(actor, action.getRootAbility());
+    }
+
+    private static int relationship(Player beneficiary, Player player) {
+        return player == beneficiary || beneficiary.getAllies().contains(player) ? 1 : -1;
+    }
+
+    private static List<Card> eligible(Player from, Player to, SpellAbility action) {
+        ZoneType zone = ZoneType.smartValueOf(action.getParamOrDefault("Zone", "Battlefield"));
+        CardCollectionView pool = AbilityUtils.filterListByType(from.getCardsIn(zone),
+                action.getParamOrDefault("Type", "Card"), action);
+        List<Card> result = new ArrayList<>();
+        for (Card card : pool) {
+            AITimeoutTracker.check();
+            if (!card.isPhasedOut() && card.canBeControlledBy(to)) result.add(card);
+        }
+        return result;
+    }
+
+    private static Map<Card, Integer> values(List<Card> first, List<Card> second) {
+        Map<Card, Integer> result = new IdentityHashMap<>();
+        for (List<Card> group : List.of(first, second)) for (Card card : group) {
+            AITimeoutTracker.check();
+            result.put(card, card.isCreature() ? ComputerUtilCard.evaluateCreature(card)
+                    : ComputerUtilCard.evaluatePermanentList(new CardCollection(card)));
+        }
+        return result;
+    }
+
+    /** Pure paired selection; do not replay an already resolving parent or cache live-world cards. */
+    public static CardCollection chooseCards(Player actor, CardCollectionView pool,
+            SpellAbility action, int min, int max) {
+        List<Player> players = new ArrayList<>();
+        action.getTargets().getTargetPlayers().forEach(players::add);
+        CardCollection result = new CardCollection();
+        if (players.size() != 2 || min < 0 || max < min) return result;
+        Player firstPlayer = players.get(0), secondPlayer = players.get(1);
+        if (firstPlayer == secondPlayer || firstPlayer.getGame() != actor.getGame()
+                || secondPlayer.getGame() != actor.getGame()) return result;
+        Player beneficiary = DecisionPerspective.beneficiary(actor);
+        int delta = relationship(beneficiary, secondPlayer) - relationship(beneficiary, firstPlayer);
+        List<Card> first = eligible(firstPlayer, secondPlayer, action);
+        List<Card> second = eligible(secondPlayer, firstPlayer, action);
+        Map<Card, Integer> values = values(first, second);
+        first.sort(Comparator.<Card>comparingLong(card -> delta * (long) values.get(card))
+                .reversed().thenComparingInt(Card::getId));
+        second.sort(Comparator.<Card>comparingLong(card -> -delta * (long) values.get(card))
+                .reversed().thenComparingInt(Card::getId));
+        int limit = Math.min(max, Math.min(first.size(), second.size()));
+        if (limit < min) return result;
+        long gain = 0;
+        long bestGain = min == 0 ? 0 : Long.MIN_VALUE;
+        int bestCount = min;
+        for (int count = 1; count <= limit; count++) {
+            AITimeoutTracker.check();
+            gain += delta * (long) values.get(first.get(count - 1));
+            gain -= delta * (long) values.get(second.get(count - 1));
+            if (count >= min && gain > bestGain) {
+                bestGain = gain;
+                bestCount = count;
+            }
+        }
+        for (int index = 0; index < bestCount; index++) {
+            Card left = first.get(index), right = second.get(index);
+            if (pool.contains(left)) result.add(left);
+            if (pool.contains(right)) result.add(right);
+        }
+        return result;
+    }
+}

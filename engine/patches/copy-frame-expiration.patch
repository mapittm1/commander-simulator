+    /** A copy's deadline retains mapped pre-copy references rather than an original-game closure. */
+    private static final class CloneExpiration implements forge.game.SnapshotCommand {
+        private static final long serialVersionUID = 1L;
+        private final Card card;
+        private final long timestamp;
+        private final CardCollection imprinted;
+        private final List<Object> remembered;
+        private CloneExpiration(Card card, long timestamp, Iterable<Card> imprinted,
+                Iterable<Object> remembered) {
+            this.card = card;
+            this.timestamp = timestamp;
+            this.imprinted = new CardCollection(imprinted);
+            this.remembered = Lists.newArrayList(remembered);
+        }
+        @Override
+        public void run() {
+            if (!card.removeCloneState(timestamp)) return;
+            card.clearImprintedCards();
+            card.clearRemembered();
+            card.addImprintedCards(IterableUtil.filter(imprinted, CardPredicates.ownerLives()));
+            card.addRemembered(IterableUtil.filter(remembered, Player.class));
+            card.addRemembered(IterableUtil.filter(IterableUtil.filter(remembered, Card.class),
+                    CardPredicates.ownerLives()));
+            card.updateStateForView();
+            card.getGame().fireEvent(new GameEventCardStatsChanged(card));
+        }
+        @Override
+        public forge.game.SnapshotCommand copyForSnapshot(
+                forge.game.spellability.SpellAbilitySnapshot context) {
+            List<Object> restored = Lists.newArrayList();
+            // The native restoration intentionally retains only Card and Player remembered values.
+            for (Object value : remembered) {
+                if (value instanceof Card saved) restored.add(context.map(saved));
+                else if (value instanceof Player saved) restored.add(context.map(saved));
+            }
+            return new CloneExpiration(context.map(card), timestamp, context.cards(imprinted), restored);
+        }
+    }
+

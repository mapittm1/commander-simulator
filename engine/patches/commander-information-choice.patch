+package forge.ai;
+
+import forge.game.ability.ApiType;
+import forge.game.card.Card;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.staticability.StaticAbility;
+import forge.game.zone.ZoneType;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+
+/** Bounded information policy using authorized access and explicit remembered positions. */
+public final class InformationEffects {
+    public static final int INFORMATION_PERMANENT_VALUE = 4;
+    private static final String OWN_TOP = "Card.TopLibrary+YouCtrl";
+    private static final String ENEMY_FACE = "Creature.faceDown+YouDontCtrl";
+    private static final String ENEMY_HAND = "Card.OppCtrl";
+    private static final Set<String> STATIC_KEYS = Set.of("Mode", "Affected", "AffectedZone", "MayLookAt", "Description");
+    private static final Set<String> ROOT_KEYS = Set.of("SP", "Cost", "Defined", "ValidTgts", "TargetMin", "TargetMax", "MinTgts", "MaxTgts", "SubAbility", "StackDescription", "SpellDescription", "TgtPrompt");
+
+    private InformationEffects() { }
+
+    public static boolean supportsPrimary(SpellAbility action) {
+        return action != null && action.isSpell() && (isInspectionChain(action)
+                || action.getApi() == ApiType.PermanentNoncreature && isPureInformationPermanent(action.getHostCard()));
+    }
+
+    public static boolean isPureInformationPermanent(Card card) {
+        if (card.isCreature() || card.isLand() || card.getStaticAbilities().isEmpty()
+                || !card.getManaAbilities().isEmpty() || !card.getKeywords().isEmpty() || !card.getTriggers().isEmpty()
+                || !card.getReplacementEffects().isEmpty()
+                || card.getNonManaAbilities().stream().anyMatch(SpellAbility::isActivatedAbility)) return false;
+        for (StaticAbility ability : card.getStaticAbilities()) {
+            if (!STATIC_KEYS.containsAll(ability.getMapParams().keySet())
+                    || !"Continuous".equals(ability.getParam("Mode"))
+                    || !"You".equals(ability.getParam("MayLookAt"))
+                    || !ability.hasParam("Affected") || !ability.hasParam("AffectedZone")) return false;
+            List<String> zones = List.of(ability.getParam("AffectedZone").split(","));
+            for (String shape : ability.getParam("Affected").split(",")) {
+                String zone = switch (shape) {
+                    case OWN_TOP -> "Library";
+                    case ENEMY_FACE -> "Battlefield";
+                    case ENEMY_HAND -> "Hand";
+                    default -> null;
+                };
+                if (zone == null || !zones.contains(zone)) return false;
+            }
+        }
+        return true;
+    }
+
+    public static boolean isInspectionChain(SpellAbility action) {
+        return inspectionParts(action) != null;
+    }
+
+    private static List<SpellAbility> inspectionParts(SpellAbility action) {
+        if (action == null || !action.isSpell() || action.getApi() != ApiType.Pump
+                || !ROOT_KEYS.containsAll(action.getMapParams().keySet())) return null;
+        List<SpellAbility> parts = new ArrayList<>();
+        SpellAbility part = action.getSubAbility();
+        for (int depth = 0; part != null && depth < 32; depth++, part = part.getSubAbility()) {
+            if (part.getApi() != ApiType.LookAt && part.getApi() != ApiType.RearrangeTopOfLibrary) return null;
+            parts.add(part);
+        }
+        return part == null && !parts.isEmpty() ? parts : null;
+    }
+
+    public static AiAbilityDecision chooseInspectionTargets(Player observer, SpellAbility action) {
+        if (!isInspectionChain(action)) return new AiAbilityDecision(0, AiPlayDecision.CantPlayAi);
+        // Enumerate legal targets and execute paid native outcomes, including public cast triggers.
+        // Information identity/position value is read only from the projected authorized memory.
+        return forge.ai.simulation.PaidOutcomePlanner.choose(observer, action);
+    }
+
+    private static boolean identityKnown(Player observer, Card card) {
+        return card.getView().canBeShownTo(observer.getView())
+                || AiCardMemory.isRememberedCard(observer, card, AiCardMemory.MemorySet.REVEALED_CARDS);
+    }
+
+    private static boolean librarySlotKnown(Player observer, Player owner, int index) {
+        return AiCardMemory.isLibraryPositionKnown(observer, owner, index)
+                || owner.getCardsIn(ZoneType.Library).get(index).getView().canBeShownTo(observer.getView());
+    }
+
+    public static int knownInformationValue(Player observer) {
+        int hand = 0;
+        int library = 0;
+        for (Player owner : observer.getGame().getPlayers()) {
+            if (owner.isOpponentOf(observer)) {
+                for (Card card : owner.getCardsIn(ZoneType.Hand)) if (identityKnown(observer, card)) hand += 2;
+            }
+            for (int index = 0; index < owner.getCardsIn(ZoneType.Library).size() && library < 8; index++) {
+                if (librarySlotKnown(observer, owner, index)) library++;
+            }
+        }
+        // Separate small budgets prevent a large library from crowding out hand or face information.
+        return InspectionKnowledge.knownFaceDownValue(observer) + Math.min(hand, 12) + Math.min(library, 8);
+    }
+}

+package forge.ai;
+
+import forge.game.card.Card;
+import forge.game.player.Player;
+import forge.game.zone.ZoneType;
+
+/** Value authorized face access and inspection memory without consulting a concealed face. */
+public final class InspectionKnowledge {
+    private static final int MAX_VALUE = 8;
+    private static final int VALUE_PER_INSPECTION = 2;
+
+    private InspectionKnowledge() { }
+
+    private static boolean isEnemyFaceDown(Card card, Player observer) {
+        return card.isInZone(ZoneType.Battlefield) && card.isFaceDown() && !card.isToken()
+                && card.getController().isOpponentOf(observer);
+    }
+
+    public static boolean isFaceDownIdentityKnown(Card card, Player observer) {
+        return card.isFaceDown() && (card.getView().canFaceDownBeShownTo(observer.getView())
+                || AiCardMemory.isRememberedCard(observer, card, AiCardMemory.MemorySet.REVEALED_CARDS));
+    }
+
+    public static boolean needsInspection(Card card, Player observer) {
+        return isEnemyFaceDown(card, observer) && !isFaceDownIdentityKnown(card, observer);
+    }
+
+    public static int knownFaceDownValue(Player observer) {
+        int value = 0;
+        for (Card card : observer.getGame().getCardsIn(ZoneType.Battlefield)) {
+            if (isEnemyFaceDown(card, observer) && isFaceDownIdentityKnown(card, observer)) {
+                value += VALUE_PER_INSPECTION;
+                if (value >= MAX_VALUE) return MAX_VALUE;
+            }
+        }
+        return value;
+    }
+}

+package forge.ai.ability;
+
+import forge.ai.AiAbilityDecision;
+import forge.ai.AiPlayDecision;
+import forge.ai.InspectionKnowledge;
+import forge.ai.SpellAbilityAi;
+import forge.game.card.Card;
+import forge.game.phase.PhaseType;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+
+/** Primary face-down inspection uses public targets and current authorized knowledge. */
+public class LookAtAi extends SpellAbilityAi {
+    @Override
+    protected AiAbilityDecision checkApiLogic(Player actor, SpellAbility action) {
+        AiAbilityDecision targets = chooseInspectionTargets(actor, action);
+        if (!targets.willingToPlay()) return targets;
+        PhaseType phase = actor.getGame().getPhaseHandler().getPhase();
+        if (phase == PhaseType.MAIN1 || phase == PhaseType.UPKEEP || phase == PhaseType.DRAW) {
+            return new AiAbilityDecision(0, AiPlayDecision.WaitForCombat);
+        }
+        return targets;
+    }
+
+    @Override
+    public AiAbilityDecision chkDrawback(Player actor, SpellAbility action) {
+        // Non-targeted inspection subeffects inherit their parent's already-announced objects.
+        if (!action.usesTargeting()) return new AiAbilityDecision(100, AiPlayDecision.WillPlay);
+        return chooseInspectionTargets(actor, action);
+    }
+
+    private AiAbilityDecision chooseInspectionTargets(Player actor, SpellAbility action) {
+        if (!action.usesTargeting()) return new AiAbilityDecision(0, AiPlayDecision.DoesntImpactGame);
+        action.resetTargets();
+        boolean hasNewInformation = false;
+        for (Card card : actor.getGame().getCardsIn(ZoneType.Battlefield)) {
+            if (InspectionKnowledge.needsInspection(card, actor) && action.canTarget(card)) {
+                action.getTargets().add(card);
+                hasNewInformation = true;
+                if (action.isTargetNumberValid()) return new AiAbilityDecision(100, AiPlayDecision.WillPlay);
+            }
+        }
+        if (!hasNewInformation) return new AiAbilityDecision(0, AiPlayDecision.DoesntImpactGame);
+        // A known legal object can fill a required additional target without inventing information value.
+        for (Card card : actor.getGame().getCardsIn(ZoneType.Battlefield)) {
+            if (action.canTarget(card)) {
+                action.getTargets().add(card);
+                if (action.isTargetNumberValid()) return new AiAbilityDecision(100, AiPlayDecision.WillPlay);
+            }
+        }
+        action.resetTargets();
+        return new AiAbilityDecision(0, AiPlayDecision.TargetingFailed);
+    }
+}

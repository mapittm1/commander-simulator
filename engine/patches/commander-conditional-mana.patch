+    // Conditional alternatives such as Gemstone Caverns produce mana in a sub-ability.
+    private static SpellAbility activeManaAbilityPart(SpellAbility ability) {
+        if (ability.getSubAbility() != null) {
+            for (SpellAbility part = ability; part != null; part = part.getSubAbility()) {
+                if (part.getManaPart() != null && part.metConditions()) {
+                    return part;
+                }
+            }
+        }
+        return ability;
+    }
+
+    private static void clearManaExpressChoices(SpellAbility ability) {
+        for (SpellAbility part = ability; part != null; part = part.getSubAbility()) {
+            if (part.getManaPart() != null) {
+                part.getManaPart().clearExpressChoice();
+            }
+        }
+    }

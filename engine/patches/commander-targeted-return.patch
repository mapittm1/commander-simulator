 public class ChangeZoneEffect extends SpellAbilityEffect {
 
     @Override
+    public boolean canChooseOptionalAction(final SpellAbility sa) {
+        // Searches and compound actions can be legal even when a later move is not.
+        if (!sa.usesTargeting() || sa.isHidden() || sa.getSubAbility() != null
+                || !sa.hasParam("Origin") || !sa.hasParam("Destination")
+                || sa.hasParam("Defined") || sa.hasParam("ThisDefinedAndTgts")
+                || sa.hasParam("DestinationAlternative") || sa.hasParam("UnlessCost")
+                || !Iterables.isEmpty(sa.getTargets().getTargetPlayers())) {
+            return true;
+        }
+        CardCollectionView targets = sa.getTargets().getTargetCards();
+        if (targets.isEmpty()) {
+            return true;
+        }
+        final Game game = sa.getActivatingPlayer().getGame();
+        final ZoneType destination = ZoneType.smartValueOf(sa.getParam("Destination"));
+        final List<ZoneType> origins = ZoneType.listValueOf(sa.getParam("Origin"));
+        for (Card previous : targets) {
+            Card current = game.getCardState(previous, null);
+            if (current != null && previous.equalsWithGameTimestamp(current)
+                    && !current.isPhasedOut() && current.getZone() != null
+                    && origins.contains(current.getZone().getZoneType())
+                    && !GameActionUtil.isZoneChangePrevented(current, destination, sa)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+

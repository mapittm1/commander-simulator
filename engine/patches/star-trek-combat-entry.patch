+    // CR 508.4e: an unrestricted replacement must preserve the original entry's attack instruction.
+    private static boolean defersToOriginalCombatEntry(SpellAbility ability, String attacking) {
+        if (!ability.isReplacementAbility() || !"True".equalsIgnoreCase(attacking)) {
+            return false;
+        }
+        SpellAbility cause = ability;
+        Set<SpellAbility> seen = Collections.newSetFromMap(new IdentityHashMap<>());
+        while (cause.isReplacementAbility() && seen.add(cause)
+                && cause.getReplacingObject(AbilityKey.OriginalParams) instanceof Map<?, ?> original
+                && original.get(AbilityKey.Cause) instanceof SpellAbility previous) {
+            if (previous.isNinjutsu() || previous.hasParam("Attacking") || previous.hasParam("TokenAttacking")) {
+                return true;
+            }
+            cause = previous;
+        }
+        return false;
+    }

diff --git a/forge-game/src/main/java/forge/game/ability/AbilityUtils.java b/forge-game/src/main/java/forge/game/ability/AbilityUtils.java
--- a/forge-game/src/main/java/forge/game/ability/AbilityUtils.java
+++ b/forge-game/src/main/java/forge/game/ability/AbilityUtils.java
@@ -3740,6 +3740,15 @@
      * @return a int.
      */
     public static int handlePaid(final Iterable<Card> paidList, final String def, final Card source, final CardTraitBase ctb) {
+        if (def.startsWith("SharesCommonCardType")) {
+            // Each card must share the same type, and an empty list satisfies the condition.
+            EnumSet<CardType.CoreType> commonTypes = EnumSet.allOf(CardType.CoreType.class);
+            for (Card card : paidList) {
+                commonTypes.retainAll(card.getType().getCoreTypes());
+            }
+            return doXMath(commonTypes.isEmpty() ? 0 : 1, CardFactoryUtil.extractOperators(def), source, ctb);
+        }
+
         if (Iterables.isEmpty(paidList)) {
             return doXMath(0, CardFactoryUtil.extractOperators(def), source, ctb);
         }

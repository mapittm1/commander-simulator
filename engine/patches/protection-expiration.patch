+    /** Explicit payload so a deadline never retains a card from another game. */
+    static final class CardProtectionExpiration implements forge.game.SnapshotCommand {
+        private static final long serialVersionUID = 1L;
+        private final Card card;
+        private final long timestamp;
+        CardProtectionExpiration(Card card, long timestamp) {
+            this.card = card;
+            this.timestamp = timestamp;
+        }
+        @Override
+        public void run() {
+            if (card.isInPlay()) {
+                card.removeChangedCardKeywords(timestamp, 0, true);
+                card.getGame().fireEvent(new GameEventCardStatsChanged(card));
+            }
+        }
+        @Override
+        public forge.game.SnapshotCommand copyForSnapshot(
+                forge.game.spellability.SpellAbilitySnapshot context) {
+            return new CardProtectionExpiration(context.map(card), timestamp);
+        }
+    }
+

+    /**
+     * Restore existing copiable/face state without casting or allocating timestamps.
+     * References inside clone records are mapped after all live cards exist.
+     */
+    public void copySnapshotCastFormFrom(final Card original) {
+        prototypeTimestamp = original.prototypeTimestamp;
+        facedown = original.facedown;
+        clonedStates.clear();
+        for (Map.Entry<Long, CardCloneStates> entry : original.clonedStates.entrySet()) {
+            clonedStates.put(entry.getKey(), entry.getValue().copy(this, false));
+        }
+        setFlipped(original.isFlipped());
+        setBackSide(original.isBackSide());
+        if (original.isFaceDown()) {
+            getFaceDownState().copyFrom(original.getFaceDownState(), false);
+        }
+        setState(original.getCurrentStateName(), false, true);
+        if (original.isBestowed()) {
+            applyBestowForm(original.bestowTimestamp, false);
+        }
+        updateKeywordsCache();
+        if (original.faceDownStateResetPending) {
+            scheduleFaceDownStateReset();
+        }
+        updateStateForView();
+    }
+
+    /** Install a fresh callback bound to this card, with copyable scheduling metadata. */
+    public void scheduleFaceDownStateReset() {
+        if (faceDownStateResetPending) {
+            return;
+        }
+        faceDownStateResetPending = true;
+        addFaceupCommand(new GameCommand() {
+            private static final long serialVersionUID = 1L;
+
+            @Override
+            public void run() {
+                clearStates(CardStateName.FaceDown, true);
+                faceDownStateResetPending = false;
+            }
+        });
+    }
+
+    /** Remap clone, exile and effect provenance after structural forms exist. */
+    public void copySnapshotCastFormReferencesFrom(final Card original,
+            final forge.game.spellability.SpellAbilitySnapshot context) {
+        for (Map.Entry<Long, CardCloneStates> entry : original.clonedStates.entrySet()) {
+            clonedStates.get(entry.getKey()).copySnapshotReferencesFrom(entry.getValue(), context);
+        }
+        setExiledWith(context.map(original.exiledWith));
+        exiledBy = context.map(original.exiledBy);
+        exiledSA = context.copy(original.exiledSA);
+        effectSource = context.map(original.effectSource);
+        effectSourceAbility = context.copy(original.effectSourceAbility);
+    }
 }

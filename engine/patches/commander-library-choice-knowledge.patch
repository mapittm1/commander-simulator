+    /** Observe the actual inspected prefix before any private choice or replacement moves it. */
+    public void observeInspectedLibraryPrefix(Player owner, PlayerController observer, CardCollectionView inspected) {
+        CardCollectionView library = owner.getCardsIn(ZoneType.Library);
+        Map<Integer, Card> disclosed = Maps.newHashMap();
+        for (int index = 0; index < inspected.size() && index < library.size(); index++) {
+            Card current = library.get(index);
+            if (current.getZone() == owner.getZone(ZoneType.Library) && current.equalsWithGameTimestamp(inspected.get(index))) {
+                disclosed.put(index, current);
+            }
+        }
+        observer.observeLibraryTop(owner, disclosed);
+    }
+
+    /**
+     * Retain only announced placements of inspected cards, never unobserved library identities.
+     * Top cards were inserted at index zero in list order; bottom cards were appended.
+     * The observer may be a different player from the library owner, as with rearrange effects.
+     */
+    public void observeChosenLibraryOrder(Player owner, PlayerController observer,
+            CardCollectionView toTop, CardCollectionView toBottom) {
+        CardCollectionView library = owner.getCardsIn(ZoneType.Library);
+        Map<Integer, Card> disclosed = Maps.newHashMap();
+        int topCount = toTop == null ? 0 : toTop.size();
+        for (int index = 0; index < topCount && index < library.size(); index++) {
+            Card announced = toTop.get(topCount - 1 - index);
+            Card current = library.get(index);
+            if (current.getZone() == owner.getZone(ZoneType.Library) && current.equalsWithGameTimestamp(announced)) {
+                disclosed.put(index, current);
+            }
+        }
+        int bottomCount = toBottom == null ? 0 : toBottom.size();
+        for (int offset = 0; offset < bottomCount; offset++) {
+            int index = library.size() - bottomCount + offset;
+            if (index < 0) continue;
+            Card announced = toBottom.get(offset);
+            Card current = library.get(index);
+            if (current.getZone() == owner.getZone(ZoneType.Library) && current.equalsWithGameTimestamp(announced)) {
+                disclosed.put(index, current);
+            }
+        }
+        // A later hidden shuffle invalidates these positions through the library revision.
+        observer.observeLibraryTop(owner, disclosed);
+    }

     public final boolean isUniqueTargets() {
         return this.uniqueTargets;
     }
+    /** A retarget keeps the announced number of targets; other restrictions survive. */
+    public TargetRestrictions forRetargeting(final int count) {
+        if (count < 0) throw new IllegalArgumentException("Negative target count");
+        TargetRestrictions result = copy();
+        result.minTargets = Integer.toString(count);
+        result.maxTargets = Integer.toString(count);
+        return result;
+    }
+
     public final void setUniqueTargets(final boolean unique) {
         this.uniqueTargets = unique;
     }

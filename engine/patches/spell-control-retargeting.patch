diff --git a/forge-ai/src/main/java/forge/ai/ability/ControlSpellAi.java b/forge-ai/src/main/java/forge/ai/ability/ControlSpellAi.java
new file mode 100644
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/ability/ControlSpellAi.java
@@ -0,0 +1,62 @@
+package forge.ai.ability;
+
+import forge.ai.AiAbilityDecision;
+import forge.ai.AiPlayDecision;
+import forge.ai.SpellAbilityAi;
+import forge.ai.simulation.GameSimulator;
+import forge.ai.simulation.GameStateEvaluator.Score;
+import forge.ai.simulation.SimulationController;
+import forge.game.player.Player;
+import forge.game.spellability.AbilitySub;
+import forge.game.spellability.SpellAbility;
+import forge.util.AITimeoutTracker;
+import forge.util.MyRandom;
+import java.util.Random;
+
+/** Compare paid native responses with letting the pending stack resolve. */
+public final class ControlSpellAi extends SpellAbilityAi {
+    private static final ThreadLocal<Boolean> ASSESSING = ThreadLocal.withInitial(() -> false);
+
+    @Override
+    protected AiAbilityDecision checkApiLogic(Player ai, SpellAbility action) {
+        if (ASSESSING.get() || action instanceof AbilitySub || action.isTrigger()
+                || ai.getGame().getStack().isResolving() || !action.usesTargeting()) {
+            return new AiAbilityDecision(0, AiPlayDecision.AnotherTime);
+        }
+        ASSESSING.set(true);
+        try {
+            return MyRandom.withRandom(new Random(0L), () -> assess(ai, action));
+        } finally {
+            ASSESSING.remove();
+        }
+    }
+
+    private AiAbilityDecision assess(Player ai, SpellAbility action) {
+        Score baseline = MyRandom.withRandom(new Random(0L),
+                () -> GameSimulator.scoreForDecision(ai.getGame(), ai));
+        SpellAbility best = null;
+        Score bestScore = baseline;
+        for (var entry : ai.getGame().getStack()) {
+            AITimeoutTracker.check();
+            SpellAbility pending = entry.getSpellAbility();
+            if (!action.canTargetSpellAbility(pending)) continue;
+            SpellAbility trial = action.copy();
+            trial.resetTargets();
+            trial.getTargets().add(pending);
+            Score result = MyRandom.withRandom(new Random(0L), () -> {
+                SimulationController controller = new SimulationController(baseline, 0);
+                GameSimulator simulator = new GameSimulator(controller, ai.getGame(), ai, null);
+                return simulator.simulateSpellAbility(trial);
+            });
+            if (result.value != Integer.MIN_VALUE && result.value > bestScore.value
+                    && result.availableValue > baseline.availableValue) {
+                best = pending;
+                bestScore = result;
+            }
+        }
+        action.resetTargets();
+        if (best == null) return new AiAbilityDecision(0, AiPlayDecision.DoesntImpactGame);
+        action.getTargets().add(best);
+        return new AiAbilityDecision(100, AiPlayDecision.WillPlay);
+    }
+}

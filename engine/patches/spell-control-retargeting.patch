diff --git a/forge-ai/src/main/java/forge/ai/simulation/RetargetChooser.java b/forge-ai/src/main/java/forge/ai/simulation/RetargetChooser.java
new file mode 100644
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/simulation/RetargetChooser.java
@@ -0,0 +1,73 @@
+package forge.ai.simulation;
+
+import forge.ai.SpellApiToAi;
+import forge.game.Game;
+import forge.game.GameObject;
+import forge.game.cost.Cost;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.spellability.TargetChoices;
+import forge.util.MyRandom;
+import java.util.Random;
+import java.util.function.Predicate;
+
+/** Native effect heuristics on an isolated world; retargeting never recasts a spell. */
+public final class RetargetChooser {
+    private static final ThreadLocal<Boolean> CHOOSING = ThreadLocal.withInitial(() -> false);
+
+    private RetargetChooser() { }
+
+    public static TargetChoices choose(Player actor, SpellAbility ability, Predicate<GameObject> filter) {
+        TargetChoices original = ability.getTargets();
+        if (CHOOSING.get() || !ability.usesTargeting() || original.isEmpty()) return original;
+        CHOOSING.set(true);
+        try {
+            TargetChoices selected = MyRandom.withRandom(new Random(0L), () -> proposed(actor, ability, filter));
+            if (selected != null) ability.setTargets(selected);
+            return ability.getTargets();
+        } finally {
+            CHOOSING.remove();
+        }
+    }
+
+    private static TargetChoices proposed(Player actor, SpellAbility ability, Predicate<GameObject> filter) {
+        Game source = actor.getGame();
+        GameCopier copier = new GameCopier(source).withStack(true);
+        copier.makeCopy();
+        SpellAbility projected = copier.find(ability);
+        Player copiedActor = copier.find(ability.getActivatingPlayer());
+        Player beneficiary = copier.find(DecisionPerspective.beneficiary(actor));
+        int count = ability.getTargets().size();
+        projected.setTargetRestrictions(projected.getTargetRestrictions().forRetargeting(count));
+        // We are choosing targets for an already-paid spell, not paying its cost again.
+        projected.getRootAbility().setPayCosts(new Cost("0", projected.getRootAbility().isAbility()));
+        projected.setPayCosts(new Cost("0", projected.isAbility()));
+        projected.resetTargets();
+        if (!SpellApiToAi.Converter.get(projected).doTrigger(beneficiary, projected, true)
+                || projected.getActivatingPlayer() != copiedActor || projected.getTargets().size() != count) return null;
+        TargetChoices mapped = new TargetChoices();
+        SpellAbility validation = ability.copy();
+        validation.resetTargets();
+        int slot = 0;
+        for (GameObject target : projected.getTargets()) {
+            GameObject originalTarget = reverse(source, copier, target);
+            if (originalTarget == null) return null;
+            boolean retained = originalTarget == ability.getTargets().get(slot);
+            if (!retained && (filter != null && !filter.test(originalTarget) || !validation.canTarget(originalTarget))) return null;
+            if (!validation.getTargets().add(originalTarget) || !mapped.add(originalTarget)) return null;
+            Integer allocation = ability.getDividedValue(ability.getTargets().get(slot++));
+            if (allocation != null) mapped.addDividedAllocation(originalTarget, allocation);
+        }
+        return validation.isTargetNumberValid() ? mapped : null;
+    }
+
+    private static GameObject reverse(Game game, GameCopier copier, GameObject object) {
+        if (!(object instanceof SpellAbility)) return copier.reverseFind(object);
+        for (var entry : game.getStack()) {
+            for (SpellAbility action = entry.getSpellAbility(); action != null; action = action.getSubAbility()) {
+                if (copier.find(action) == object) return action;
+            }
+        }
+        return null;
+    }
+}

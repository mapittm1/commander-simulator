+    /** Keep expiry attached to the effect in the world that owns this queue. */
+    private static final class ExpireSkipPhaseCommand implements SnapshotCommand {
+        private static final long serialVersionUID = 1L;
+        private final Card effect;
+
+        private ExpireSkipPhaseCommand(final Card effect) {
+            this.effect = effect;
+        }
+
+        @Override
+        public void run() {
+            effect.getGame().getAction().exileEffect(effect);
+        }
+
+        @Override
+        public SnapshotCommand copyForSnapshot(final SpellAbilitySnapshot context) {
+            return new ExpireSkipPhaseCommand(context.map(effect));
+        }
+    }
+
+    /** Deferred entry and expiry must share the same copied effect object. */
+    private static final class BeginSkipPhaseCommand implements SnapshotCommand {
+        private static final long serialVersionUID = 1L;
+        private final Card effect;
+        private final SpellAbility source;
+
+        private BeginSkipPhaseCommand(final Card effect, final SpellAbility source) {
+            this.effect = effect;
+            this.source = source;
+        }
+
+        @Override
+        public void run() {
+            effect.getGame().getAction().moveToCommand(effect, source);
+        }
+
+        @Override
+        public SnapshotCommand copyForSnapshot(final SpellAbilitySnapshot context) {
+            return new BeginSkipPhaseCommand(context.map(effect), context.copy(source));
+        }
+    }

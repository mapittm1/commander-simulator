 import com.google.common.collect.Sets;
 
 public class LifeGainEffect extends SpellAbilityEffect {
+
+    @Override
+    public boolean canChooseOptionalAction(final SpellAbility sa) {
+        // A reveal/payment or an independent later action may still be legal.
+        if (sa.hasParam("UnlessCost") || (sa.getSubAbility() != null
+                && !"GainLife".equals(sa.getParam("OptionalAction")))) {
+            return true;
+        }
+        for (Player player : getDefinedPlayersOrTargeted(sa)) {
+            if (player.isInGame() && player.canGainLife()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
 

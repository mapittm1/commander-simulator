+    /** Retained sacrifice-cost moves need the same look-back view as ordinary moves. */
+    private void collectHeldZoneChange(TriggerWaiting waiting) {
+        Object before = waiting.getParams().get(AbilityKey.LastStateBattlefield);
+        if (!ZoneType.Battlefield.name().equals(waiting.getParams().get(AbilityKey.Origin))
+                || !(before instanceof CardCollectionView battlefield)) {
+            collectWaitingTrigger(waiting);
+            return;
+        }
+        // Capture the event without changing the live trigger registry or running effects.
+        List<Trigger> current = new ArrayList<>(activeTriggers);
+        try {
+            resetActiveTriggers(false, battlefield);
+            for (Card card : battlefield) {
+                registerActiveLTBTrigger(card);
+            }
+            collectWaitingTrigger(waiting);
+        } finally {
+            activeTriggers.clear();
+            activeTriggers.addAll(current);
+        }
     }
 

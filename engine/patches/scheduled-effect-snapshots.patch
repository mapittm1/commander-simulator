+    /** Expiration data stays explicit so a snapshot never retains an original-game closure. */
+    private static final class CardPumpRemoval implements forge.game.SnapshotCommand {
+        private static final long serialVersionUID = 1L;
+        private final Card host;
+        private final Card target;
+        private final long timestamp;
+        private final boolean removeKeywords;
+
+        private CardPumpRemoval(Card host, Card target, long timestamp, boolean removeKeywords) {
+            this.host = host;
+            this.target = target;
+            this.timestamp = timestamp;
+            this.removeKeywords = removeKeywords;
+        }
+
+        @Override
+        public void run() {
+            host.removeGainControlTargets(target);
+            target.removePTBoost(timestamp, 0);
+            boolean updateText = target.removeCanBlockAny(timestamp);
+            updateText |= target.removeCanBlockAdditional(timestamp);
+            if (removeKeywords) {
+                target.removeHiddenExtrinsicKeywords(timestamp, 0);
+                target.removeChangedCardKeywords(timestamp, 0);
+            }
+            target.updatePTforView();
+            if (updateText) {
+                target.updateAbilityTextForView();
+            }
+            target.getGame().fireEvent(new GameEventCardStatsChanged(target));
+        }
+
+        @Override
+        public forge.game.SnapshotCommand copyForSnapshot(
+                forge.game.spellability.SpellAbilitySnapshot context) {
+            return new CardPumpRemoval(context.map(host), context.map(target), timestamp, removeKeywords);
+        }
+    }

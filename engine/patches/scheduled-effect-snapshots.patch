+    public void copySnapshotKeywordsFrom(Player original,
+            forge.game.spellability.SpellAbilitySnapshot context) {
+        changedKeywords = TreeBasedTable.create();
+        for (Table.Cell<Long, Long, IKeywordsChange> cell : original.changedKeywords.cellSet()) {
+            if (!(cell.getValue() instanceof KeywordsChange change)) {
+                throw new IllegalStateException("Unmapped player keyword change: "
+                        + cell.getValue().getClass().getName());
+            }
+            changedKeywords.put(cell.getRowKey(), cell.getColumnKey(),
+                    change.copyForSnapshot(keywordEffect, context));
+        }
+        storedKeywords.clear();
+        for (Table.Cell<Long, String, KeywordInterface> cell : original.storedKeywords.cellSet()) {
+            storedKeywords.put(cell.getRowKey(), cell.getColumnKey(),
+                    context.keyword(cell.getValue(), keywordEffect));
+        }
+        keywords = new KeywordCollection();
+        keywords.applyChanges(changedKeywords.values());

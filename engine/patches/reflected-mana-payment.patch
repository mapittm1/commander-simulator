+    private static boolean isProjectedManaEffect(SpellAbility effect) {
+        return effect.getApi() == ApiType.Mana || effect.getApi() == ApiType.ManaReflected
+                || effect.getApi() == ApiType.RepeatEach && effect.hasParam("RepeatCards");
+    }
+
+    private static void appendProjectedMana(StringBuilder result, SpellAbility effect, SpellAbility payingFor,
+            Player payer, ManaCostBeingPaid cost, String landMana) {
+        if (!effect.metConditions() || effect.usesTargeting() || effect.hasParam("UnlessCost")) {
+            return;
+        }
+        Card host = effect.getHostCard();
+        int repetitions = 1;
+        if (effect.getApi() == ApiType.RepeatEach) {
+            SpellAbility repeated = effect.getAdditionalAbility("RepeatSubAbility");
+            if (effect.hasParam("Optional") || effect.hasParam("UseImprinted") || repeated == null
+                    || repeated.getApi() != ApiType.ManaReflected || repeated.getSubAbility() != null
+                    || repeated.hasParam("UnlessCost") || repeated.usesTargeting() || !repeated.metConditions()) {
+                return;
+            }
+            List<ZoneType> zones = effect.hasParam("Zone")
+                    ? ZoneType.listValueOf(effect.getParam("Zone")) : List.of(ZoneType.Battlefield);
+            repetitions = CardLists.getValidCards(payer.getGame().getCardsIn(zones), effect.getParam("RepeatCards"),
+                    host.getController(), host, effect).size();
+            effect = repeated;
+        }
+        AbilityManaPart part = effect.getManaPart();
+        if (repetitions == 0 || part == null || !part.meetsManaRestrictions(payingFor)
+                || !AbilityUtils.getDefinedPlayers(host, effect.getParamOrDefault("Defined", "You"), effect).contains(payer)) {
+            return;
+        }
+        String produced;
+        if (effect.getApi() == ApiType.Mana) {
+            produced = effect.getParam("Produced");
+            if ("Chosen".equals(produced)) {
+                produced = MagicColor.toShortString(host.getChosenColor());
+            }
+            repetitions = AbilityUtils.calculateAmount(host, effect.getParamOrDefault("Amount", "1"), effect);
+        } else {
+            if (!"Produced".equals(effect.getParam("ReflectProperty"))) {
+                return;
+            }
+            boolean type = "Type".equals(effect.getParam("ColorOrType"));
+            List<String> available = Arrays.stream(landMana.split(" "))
+                    .filter(mana -> !mana.isEmpty() && (type || !mana.equals("C")))
+                    .distinct().toList();
+            if (available.isEmpty()) {
+                return;
+            }
+            ManaCostBeingPaid remaining = new ManaCostBeingPaid(cost);
+            payMultipleMana(remaining, result.toString(), payer);
+            for (int index = 0; index < repetitions; index++) {
+                String choice = chooseReflectedType(available, remaining, payer.getManaPool());
+                result.append(" ").append(choice);
+                remaining.ai_payMana(choice, payer.getManaPool());
+            }
+            return;
+        }
+        if (!produced.isEmpty() && repetitions > 0) {
+            result.append(" ").append(StringUtils.repeat(produced, " ", repetitions));
+        }
+    }
+
+    private static String chooseReflectedType(Collection<String> available, ManaCostBeingPaid remaining, ManaPool pool) {
+        String choice = available.iterator().next();
+        int bestMana = Integer.MAX_VALUE;
+        int bestColored = Integer.MAX_VALUE;
+        for (String option : available) {
+            ManaCostBeingPaid candidate = new ManaCostBeingPaid(remaining);
+            candidate.ai_payMana(MagicColor.toShortString(option), pool);
+            int total = candidate.getConvertedManaCost();
+            int colored = total - candidate.getGenericManaAmount();
+            if (total < bestMana || (total == bestMana && colored < bestColored)) {
+                choice = option;
+                bestMana = total;
+                bestColored = colored;
+            }
+        }
+        return choice;
+    }
+
+    private static void resolveManaAbility(SpellAbility source, SpellAbility payingFor,
+            ManaCostBeingPaid cost, Player payer) {
+        AbilityManaPart manaPart = source.getManaPart();
+        var previousChoice = manaPart.setReflectedManaChoice((recipient, available) ->
+                recipient == payer ? chooseReflectedTypeForPayment(available, cost, payingFor, payer.getManaPool()) : null);
+        try {
+            payer.getGame().getStack().addAndUnfreeze(source);
+        } finally {
+            manaPart.setReflectedManaChoice(previousChoice);
+        }
+    }
+
+    private static String chooseReflectedTypeForPayment(Collection<String> available, ManaCostBeingPaid cost,
+            SpellAbility payingFor, ManaPool pool) {
+        ManaCostBeingPaid remaining = new ManaCostBeingPaid(cost);
+        for (Mana mana : pool) {
+            if (remaining.isNeeded(mana, pool) && mana.meetsManaRestrictions(payingFor)
+                    && payingFor.allowsPayingWithShard(mana.getSourceCard(), mana.getColor())) {
+                remaining.payMana(mana, pool);
+            }
+        }
+        return chooseReflectedType(available, remaining, pool);
     }
 

+package forge.ai.ability;
+
+import forge.ai.AiAbilityDecision;
+import forge.ai.AiPlayDecision;
+import forge.ai.ComputerUtilCard;
+import forge.ai.SpellAbilityAi;
+import forge.game.card.Card;
+import forge.game.card.CardLists;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+
+import java.util.Comparator;
+import java.util.List;
+
+/** Basic text-value preferences, with a legal fallback for mandatory exchanges. */
+public class TextBoxExchangeAi extends SpellAbilityAi {
+    @Override
+    protected AiAbilityDecision canPlay(Player ai, SpellAbility sa) {
+        return select(ai, sa, sa.isMandatory());
+    }
+    @Override
+    public AiAbilityDecision chkDrawback(Player ai, SpellAbility sa) {
+        return select(ai, sa, sa.isMandatory());
+    }
+    @Override
+    protected AiAbilityDecision doTriggerNoCost(Player ai, SpellAbility sa, boolean mandatory) {
+        return select(ai, sa, mandatory);
+    }
+    private static int textValue(Card card) {
+        return ComputerUtilCard.evaluateCreature(card, false, false);
+    }
+    private static AiAbilityDecision select(Player ai, SpellAbility sa, boolean mandatory) {
+        if (!sa.usesTargeting()) return new AiAbilityDecision(100, AiPlayDecision.WillPlay);
+        sa.resetTargets();
+        List<Card> candidates = CardLists.getValidCards(ai.getGame().getCardsIn(ZoneType.Battlefield),
+                sa.getTargetRestrictions().getValidTgts(), ai, sa.getHostCard(), sa);
+        candidates = CardLists.filter(candidates, sa::canTarget);
+        Card friendly = candidates.stream().filter(c -> !ai.isOpponentOf(c.getController()))
+                .min(Comparator.comparingInt(TextBoxExchangeAi::textValue)).orElse(null);
+        Card opponent = candidates.stream().filter(c -> ai.isOpponentOf(c.getController()))
+                .max(Comparator.comparingInt(TextBoxExchangeAi::textValue)).orElse(null);
+        if (friendly != null && opponent != null && textValue(opponent) > textValue(friendly)) {
+            sa.getTargets().add(friendly);
+            if (sa.canTarget(opponent)) sa.getTargets().add(opponent);
+            if (sa.isTargetNumberValid()) return new AiAbilityDecision(100, AiPlayDecision.WillPlay);
+            sa.resetTargets();
+        }
+        if (mandatory) {
+            for (Card card : candidates) {
+                if (!sa.canAddMoreTarget()) break;
+                if (sa.canTarget(card)) sa.getTargets().add(card);
+            }
+            if (sa.isTargetNumberValid()) return new AiAbilityDecision(100, AiPlayDecision.WillPlay);
+        }
+        sa.resetTargets();
+        return new AiAbilityDecision(0, mandatory ? AiPlayDecision.TargetingFailed : AiPlayDecision.CantPlayAi);
+    }
+}

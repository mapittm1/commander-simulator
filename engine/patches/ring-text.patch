+            Card current = game.getCardState(previous, null);
+            if (current != null && previous.equalsWithGameTimestamp(current)) {
+                current.removeChangedCardTraitsByText(timestamp, 0);
+                current.removeChangedCardKeywords(timestamp, 0, false);
+                current.updateChangedText();
+                current.updateStateForView();
+                game.fireEvent(new GameEventCardStatsChanged(current));
+            }

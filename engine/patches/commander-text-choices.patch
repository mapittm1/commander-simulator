--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/simulation/TextChangeChoices.java
@@ -0,0 +1,431 @@
+package forge.ai.simulation;
+
+import forge.card.CardType;
+import forge.card.ColorSet;
+import forge.card.MagicColor;
+import forge.game.ability.AbilityUtils;
+import forge.game.ability.ApiType;
+import forge.game.card.Card;
+import forge.game.keyword.KeywordInterface;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+import forge.util.AITimeoutTracker;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** Legal text-word variants and replay through native resolution callbacks. */
+public final class TextChangeChoices {
+    private static final String COLOR_FROM = "AITextColorFrom";
+    private static final String COLOR_TO = "AITextColorTo";
+    private static final String TYPE_FROM = "AITextTypeFrom";
+    private static final String TYPE_TO = "AITextTypeTo";
+    private static final String DECIDER = "AITextDecider";
+    private static final String TARGETS = "AITextTargets";
+    private static final List<String> KEYS = List.of(
+            COLOR_FROM, COLOR_TO, TYPE_FROM, TYPE_TO, DECIDER, TARGETS);
+    private static final List<String> COLORS = List.of("White", "Blue", "Black", "Red", "Green");
+    private static final List<String> PARAMETERS = List.of("ChangeColorWord", "ChangeTypeWord");
+    private static final int MAX_VARIANTS = 128;
+    private static final int MAX_VISIBLE_CARDS = 512;
+    private static final String FULL_OWNER = "AITextFullOwner";
+    private static final String FULL_TARGETS = "AITextFullTargets";
+    private static final String FULL_COUNT = "AITextFullCount";
+    private static final String FULL_POSITION = "AITextFullPosition";
+    private static final String FULL_WORD = "AITextFullWord";
+
+
+    private TextChangeChoices() { }
+
+    public static List<SpellAbility> variants(SpellAbility targeted) {
+        List<SpellAbility> result = new ArrayList<>();
+        for (Words color : pairs(targeted, "ChangeColorWord", true)) {
+            for (Words type : pairs(targeted, "ChangeTypeWord", false)) {
+                AITimeoutTracker.check();
+                SpellAbility variant = targeted.copy();
+                clearFullWords(variant);
+                for (String key : KEYS) {
+                    variant.clearPlannedAiChoice(key);
+                }
+                bind(variant, targeted);
+                if (color != null) {
+                    setWords(variant, true, color.from, color.to);
+                }
+                if (type != null) {
+                    setWords(variant, false, type.from, type.to);
+                }
+                result.add(variant);
+                if (result.size() == MAX_VARIANTS) {
+                    return result;
+                }
+            }
+        }
+        return result;
+    }
+
+    private static List<Words> pairs(SpellAbility action, String parameter, boolean color) {
+        if (!action.hasParam(parameter)) {
+            return Collections.singletonList(null);
+        }
+        String[] spec = action.getParam(parameter).split(" ");
+        if (spec.length != 2) {
+            return List.of();
+        }
+        Collection<String> original = domain(spec[0], color);
+        Collection<String> replacement = domain(spec[1], color);
+        boolean creatureReplacement = !color && spec[1].equals("ChooseCreatureType");
+        Set<String> relevant = creatureReplacement ? relevantTypes(action) : Set.of();
+        Set<String> forbidden = new LinkedHashSet<>();
+        if (!color && action.hasParam("ForbiddenNewTypes")) {
+            forbidden.addAll(List.of(action.getParam("ForbiddenNewTypes").split(",")));
+        }
+        List<Words> result = new ArrayList<>();
+        for (String from : original) {
+            AITimeoutTracker.check();
+            if (spec[0].startsWith("Choose") && !appearsInTargets(action, from)) {
+                continue;
+            }
+            for (String to : replacement) {
+                if (!legalPair(spec[1], from, to, forbidden)) {
+                    continue;
+                }
+                if (creatureReplacement && !relevant.contains(to)) {
+                    continue;
+                }
+                result.add(new Words(from, to));
+                if (result.size() == MAX_VARIANTS) {
+                    return result;
+                }
+            }
+        }
+        // A legal no-effect choice can still make casting useful through native triggers.
+        if (result.isEmpty()) {
+            for (String from : original) {
+                for (String to : replacement) {
+                    if (legalPair(spec[1], from, to, forbidden)) {
+                        return List.of(new Words(from, to));
+                    }
+                }
+            }
+        }
+        return result;
+    }
+
+    private static boolean legalPair(String replacementSpec, String from, String to, Set<String> forbidden) {
+        return (!from.equals(to) || !replacementSpec.startsWith("Choose")) && !forbidden.contains(to);
+    }
+
+    private static Collection<String> domain(String spec, boolean color) {
+        if (color && spec.equals("Choose")) {
+            return COLORS;
+        }
+        if (spec.equals("ChooseBasicLandType")) {
+            return CardType.getBasicTypes();
+        }
+        if (spec.equals("ChooseCreatureType")) {
+            return CardType.Constant.CREATURE_TYPES;
+        }
+        return List.of(spec);
+    }
+
+    private static boolean appearsInTargets(SpellAbility action, String word) {
+        Pattern pattern = wordPattern(word);
+        for (Card target : targetCards(action)) {
+            if (!target.isFaceDown() && pattern.matcher(visibleText(target)).find()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static List<Card> targetCards(SpellAbility action) {
+        List<Card> cards = new ArrayList<>(action.getTargets().getTargetCards());
+        for (SpellAbility spell : action.getTargets().getTargetSpells()) {
+            cards.add(spell.getHostCard());
+        }
+        if (cards.isEmpty() && action.getApi() == ApiType.ChangeText && action.hasParam("Defined")) {
+            cards.addAll(AbilityUtils.getDefinedCards(action.getHostCard(), action.getParam("Defined"), action));
+        }
+        return cards;
+    }
+
+    private static String targetSignature(SpellAbility action) {
+        List<String> identities = new ArrayList<>();
+        for (Card card : targetCards(action)) {
+            identities.add(card.getId() + ":" + card.getGameTimestamp());
+        }
+        Collections.sort(identities);
+        return String.join(",", identities);
+    }
+
+    private static Set<String> relevantTypes(SpellAbility action) {
+        List<String> visible = new ArrayList<>();
+        for (Card card : action.getActivatingPlayer().getGame().getCardsInGame()) {
+            AITimeoutTracker.check();
+            boolean visibleZone = card.isInZone(ZoneType.Battlefield) || card.isInZone(ZoneType.Stack)
+                    || (card.isInZone(ZoneType.Hand) && card.getOwner() == action.getActivatingPlayer());
+            if (card.isFaceDown() || !visibleZone) {
+                continue;
+            }
+            if (visible.size() == MAX_VISIBLE_CARDS) {
+                break;
+            }
+            visible.add(visibleText(card));
+        }
+        Set<String> result = new LinkedHashSet<>();
+        for (String type : CardType.Constant.CREATURE_TYPES) {
+            AITimeoutTracker.check();
+            Pattern pattern = wordPattern(type);
+            for (String text : visible) {
+                if (pattern.matcher(text).find()) {
+                    result.add(type);
+                    break;
+                }
+            }
+        }
+        return result;
+    }
+
+    private static String visibleText(Card card) {
+        String oracle = card.getOracleText();
+        if (oracle != null) {
+            // Printed irregular plurals need the current word before subsequent choices.
+            // Native keyword/type encodings are singular and remain handled below.
+            for (Map.Entry<String, String> change : card.getChangedTextTypeWords().entrySet()) {
+                String plural = CardType.getPluralType(change.getKey());
+                if (!plural.equals(change.getKey())) {
+                    String replacement = CardType.getPluralType(change.getValue());
+                    oracle = boundedWordPattern(Pattern.quote(plural)).matcher(oracle)
+                            .replaceAll("$1" + Matcher.quoteReplacement(replacement));
+                }
+            }
+        }
+        StringBuilder text = new StringBuilder(oracle == null ? "" : oracle).append(' ').append(card.getType());
+        for (KeywordInterface keyword : card.getKeywords()) {
+            text.append(' ').append(keyword.getOriginal());
+        }
+        return AbilityUtils.applyKeywordTextChangeEffects(text.toString(),
+                card.getChangedTextColorWords(), card.getChangedTextTypeWords());
+    }
+
+    private static Pattern wordPattern(String word) {
+        String alternatives = Pattern.quote(word);
+        String plural = CardType.getPluralType(word);
+        if (!plural.equals(word)) {
+            alternatives += "|" + Pattern.quote(plural);
+        }
+        return boundedWordPattern(alternatives);
+    }
+
+    private static Pattern boundedWordPattern(String alternatives) {
+        // Keep compound types whole while recognizing rules words such as nonblack.
+        return Pattern.compile("(?i)(?<![\\p{L}\\p{N}_-])(non-?)?(?:"
+                + alternatives + ")(?![\\p{L}\\p{N}_-])");
+    }
+
+    public static List<String> resolutionOptions(SpellAbility action, List<String> legal, boolean color) {
+        String[] spec = action.getParam(color ? "ChangeColorWord" : "ChangeTypeWord").split(" ");
+        if (spec.length != 2) {
+            return List.copyOf(legal);
+        }
+        Collection<String> first = domain(spec[0], color);
+        boolean original = spec[0].startsWith("Choose")
+                && first.size() == legal.size() && first.containsAll(legal);
+        boolean creatureReplacement = !color && !original && spec[1].equals("ChooseCreatureType");
+        Set<String> relevant = creatureReplacement ? relevantTypes(action) : Set.of();
+        List<String> result = new ArrayList<>();
+        for (String word : legal) {
+            if (original && !appearsInTargets(action, word)) {
+                continue;
+            }
+            if (creatureReplacement && !relevant.contains(word)) {
+                continue;
+            }
+            result.add(word);
+            if (result.size() == MAX_VARIANTS) {
+                break;
+            }
+        }
+        return result.isEmpty() && !legal.isEmpty() ? List.of(legal.get(0)) : result;
+    }
+
+    public static void installWords(SpellAbility action, List<String> words) {
+        if (words == null || action.getActivatingPlayer() == null) {
+            return;
+        }
+        int expected = 0;
+        for (SpellAbility part = action; part != null; part = part.getSubAbility()) {
+            if (part.getApi() != ApiType.ChangeText) {
+                continue;
+            }
+            for (String parameter : PARAMETERS) {
+                if (part.hasParam(parameter)) {
+                    for (String spec : part.getParam(parameter).split(" ")) {
+                        if (spec.startsWith("Choose")) {
+                            expected++;
+                        }
+                    }
+                }
+            }
+        }
+        if (expected != words.size()) {
+            return;
+        }
+        int index = 0;
+        for (SpellAbility part = action; part != null; part = part.getSubAbility()) {
+            if (part.getApi() != ApiType.ChangeText) {
+                continue;
+            }
+            bind(part, part);
+            for (String parameter : PARAMETERS) {
+                if (!part.hasParam(parameter)) {
+                    continue;
+                }
+                String[] spec = part.getParam(parameter).split(" ");
+                String from = spec[0].startsWith("Choose") ? words.get(index++) : spec[0];
+                String to = spec[1].startsWith("Choose") ? words.get(index++) : spec[1];
+                setWords(part, parameter.equals("ChangeColorWord"), from, to);
+            }
+        }
+    }
+
+    private static void bind(SpellAbility destination, SpellAbility source) {
+        destination.setPlannedAiChoice(DECIDER, String.valueOf(source.getActivatingPlayer().getId()));
+        destination.setPlannedAiChoice(TARGETS, targetSignature(source));
+    }
+
+    private static void setWords(SpellAbility action, boolean color, String from, String to) {
+        action.setPlannedAiChoice(color ? COLOR_FROM : TYPE_FROM, from);
+        action.setPlannedAiChoice(color ? COLOR_TO : TYPE_TO, to);
+    }
+
+    public static Byte plannedColor(SpellAbility action, ColorSet options) {
+        if (!plannedForActor(action) || action.getPlannedAiChoice(COLOR_FROM) == null
+                || action.getPlannedAiChoice(COLOR_TO) == null) {
+            return null;
+        }
+        byte from = MagicColor.fromName(action.getPlannedAiChoice(COLOR_FROM).toLowerCase(Locale.ROOT));
+        byte to = MagicColor.fromName(action.getPlannedAiChoice(COLOR_TO).toLowerCase(Locale.ROOT));
+        if (from != 0 && (options.getColor() & from) != 0) {
+            return from;
+        }
+        return to != 0 && (options.getColor() & to) != 0 ? to : null;
+    }
+
+    public static String plannedType(SpellAbility action, Collection<String> options) {
+        if (!plannedForActor(action) || action.getPlannedAiChoice(TYPE_FROM) == null
+                || action.getPlannedAiChoice(TYPE_TO) == null) {
+            return null;
+        }
+        String from = action.getPlannedAiChoice(TYPE_FROM), to = action.getPlannedAiChoice(TYPE_TO);
+        if (options.contains(from)) {
+            return from;
+        }
+        return options.contains(to) ? to : null;
+    }
+
+    private static boolean plannedForActor(SpellAbility action) {
+        return action.getApi() == ApiType.ChangeText && action.getActivatingPlayer() != null
+                && action.getHostCard().getGame().getStack().isResolving()
+                && String.valueOf(action.getActivatingPlayer().getId()).equals(action.getPlannedAiChoice(DECIDER))
+                && targetSignature(action).equals(action.getPlannedAiChoice(TARGETS));
+    }
+
+    private static int fullNumber(SpellAbility action, String key) {
+        String value = action.getPlannedAiChoice(key);
+        if (value == null) return 0;
+        try {
+            int result = Integer.parseInt(value);
+            return result >= 0 && result <= MAX_VARIANTS ? result : -1;
+        } catch (NumberFormatException invalid) {
+            return -1;
+        }
+    }
+
+    private static void clearFullWords(SpellAbility action) {
+        int count = fullNumber(action, FULL_COUNT);
+        for (int i = 0; i < Math.max(0, count); i++) action.clearPlannedAiChoice(FULL_WORD + i);
+        for (String key : List.of(FULL_OWNER, FULL_TARGETS, FULL_COUNT, FULL_POSITION)) action.clearPlannedAiChoice(key);
+    }
+
+    public static boolean stageFullWords(SpellAbility root, List<String> words) {
+        clearFullWords(root);
+        if (words == null || words.isEmpty()) return true;
+        if (words.size() > MAX_VARIANTS || root.getActivatingPlayer() == null) return false;
+        root.setPlannedAiChoice(FULL_OWNER, String.valueOf(root.getActivatingPlayer().getId()));
+        root.setPlannedAiChoice(FULL_TARGETS, fullTargetSignature(root, List.of()));
+        root.setPlannedAiChoice(FULL_COUNT, String.valueOf(words.size()));
+        root.setPlannedAiChoice(FULL_POSITION, "0");
+        for (int i = 0; i < words.size(); i++) root.setPlannedAiChoice(FULL_WORD + i, words.get(i));
+        return true;
+    }
+
+    private static String fullTargetSignature(SpellAbility root, List<? extends SpellAbility> modes) {
+        Set<String> identities = new java.util.TreeSet<>();
+        List<SpellAbility> chains = new ArrayList<>();
+        chains.add(root); chains.addAll(modes);
+        for (SpellAbility chain : chains) {
+            for (SpellAbility part = chain; part != null; part = part.getSubAbility()) {
+                for (Card card : targetCards(part)) identities.add(card.getId() + ":" + card.getGameTimestamp());
+            }
+        }
+        return String.join(",", identities);
+    }
+
+    public static void bindFullTargets(SpellAbility root, List<? extends SpellAbility> modes) {
+        if (fullNumber(root, FULL_COUNT) > 0)
+            root.setPlannedAiChoice(FULL_TARGETS, fullTargetSignature(root, modes));
+    }
+
+    public static String consumeFullWord(SpellAbility action, List<String> legal) {
+        SpellAbility root = action.getRootAbility();
+        if (!action.getHostCard().getGame().getStack().isResolving() || action.getActivatingPlayer() == null
+                || !String.valueOf(action.getActivatingPlayer().getId()).equals(root.getPlannedAiChoice(FULL_OWNER))
+                || !fullTargetSignature(root, List.of()).equals(root.getPlannedAiChoice(FULL_TARGETS))) return null;
+        int count = fullNumber(root, FULL_COUNT), position = fullNumber(root, FULL_POSITION);
+        if (count <= 0 || position < 0 || position >= count) return null;
+        String word = root.getPlannedAiChoice(FULL_WORD + position);
+        if (!legal.contains(word)) {
+            clearFullWords(root);
+            return null;
+        }
+        root.setPlannedAiChoice(FULL_POSITION, String.valueOf(position + 1));
+        return word;
+    }
+
+    private static void copyFullWords(SpellAbility source, SpellAbility destination) {
+        clearFullWords(destination);
+        int count = fullNumber(source, FULL_COUNT);
+        if (count <= 0) return;
+        for (String key : List.of(FULL_OWNER, FULL_TARGETS, FULL_COUNT, FULL_POSITION)) {
+            String value = source.getPlannedAiChoice(key);
+            if (value != null) destination.setPlannedAiChoice(key, value);
+        }
+        for (int i = 0; i < count; i++) {
+            String value = source.getPlannedAiChoice(FULL_WORD + i);
+            if (value != null) destination.setPlannedAiChoice(FULL_WORD + i, value);
+        }
+    }
+
+    static void copyPlan(SpellAbility source, SpellAbility destination) {
+        copyFullWords(source, destination);
+        if (source.getApi() != ApiType.ChangeText || destination.getApi() != ApiType.ChangeText) {
+            return;
+        }
+        for (String key : KEYS) {
+            destination.clearPlannedAiChoice(key);
+            if (source.getPlannedAiChoice(key) != null) {
+                destination.setPlannedAiChoice(key, source.getPlannedAiChoice(key));
+            }
+        }
+    }
+
+    private record Words(String from, String to) { }
+}

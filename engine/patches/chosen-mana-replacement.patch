+
+    /** Apply a color or type replacement without changing game state. */
+    public static String replaceManaType(SpellAbility replacement, String produced, Supplier<String> chooseColor) {
+        boolean allTypes = replacement.hasParam("ReplaceType");
+        String color = replacement.getParam(allTypes ? "ReplaceType" : "ReplaceColor");
+        if (allTypes && "Any".equals(color)) {
+            color = chooseColor.get();
+        } else if (!allTypes && "Chosen".equals(color)) {
+            if (replacement.getHostCard().hasChosenColor()) {
+                color = MagicColor.toShortString(replacement.getHostCard().getChosenColor());
+            }
+        } else {
+            color = MagicColor.toShortString(color);
+        }
+        if (!allTypes && replacement.hasParam("ReplaceOnly")) {
+            return produced.replace(replacement.getParam("ReplaceOnly"), color);
+        }
+        for (byte type : allTypes ? MagicColor.WUBRGC : MagicColor.WUBRG) {
+            produced = produced.replace(MagicColor.toShortString(type), color);
+        }
+        return produced;
+    }
 }

+    private Card sacrificeWithReceipt(Card original, Card sacrificeReceipt, Player controller, SpellAbility source,
+            Map<AbilityKey, Object> params, CostPayment payment) {
+        Zone battlefield = original.getZone();
+        int index = battlefield.getCards(false).indexOf(original);
+        CardCollection equipment = new CardCollection(original.getAllAttachedCards());
+        boolean priorDestroyed = original.getView().wasDestroyed();
+        Card priorLki = game.getChangeZoneLKIInfo(original);
+        controller.getSacrificedThisTurn().add(sacrificeReceipt);
+        var triggers = game.getTriggerHandler();
+        var sacrificed = triggers.holdPaymentTrigger(TriggerType.Sacrificed,
+                controller.sacrificeTriggerParams(sacrificeReceipt, source));
+        original.updateWasDestroyed(true);
+        SacrificeMove previous = pendingSacrifice;
+        SacrificeMove move = new SacrificeMove(original, new ArrayList<>());
+        Card result;
+        pendingSacrifice = move;
+        try {
+            result = sacrificeDestroy(original, source, params);
+        } finally {
+            pendingSacrifice = previous;
+        }
+        Card placed = result == null ? null : game.getCardState(result);
+        Zone destination = placed == null ? null : placed.getZone();
+        var placement = isReversibleSacrificeDestination(destination) && placed != original
+                ? triggers.holdZoneChange(placed, destination.getZoneType()) : null;
+        if (placement == null) {
+            payment.holdRetainedCostTrigger(sacrificed);
+            move.moveTriggers().forEach(payment::holdRetainedCostTrigger);
+            controller.fireSacrificeEvent(sacrificeReceipt);
+            return result;
+        }
+
+        Card zoneReceipt = (Card) placement.getParams().get(AbilityKey.CardLKI);
+        payment.recordReversiblePaymentMove(result, placed);
+        payment.holdCostTrigger(sacrificed);
+        move.moveTriggers().forEach(payment::holdCostTrigger);
+        payment.holdCostTrigger(placement);
+        payment.recordCommittedEvent(() -> controller.fireSacrificeEvent(sacrificeReceipt));
+        payment.recordRefund(() -> {
+            Card current = game.getCardState(placed, null);
+            if (placed.isToken() ? current != null || placed.getZone() != destination
+                    : current != placed || !destination.contains(placed)) {
+                return;
+            }
+            controller.getSacrificedThisTurn().removeIf(card -> card == sacrificeReceipt);
+            game.getLeftBattlefieldThisTurn().removeIf(card -> card == zoneReceipt);
+            game.restoreChangeZoneLKI(original, zoneReceipt, priorLki);
+            destination.removeEntryReceipt(ZoneType.Battlefield, zoneReceipt);
+            if (destination.is(ZoneType.Graveyard) && placed.isPermanent() && !placed.isToken()) {
+                Player owner = placed.getOwner();
+                owner.setDescended(owner.getDescended() - 1);
+            }
+            destination.remove(placed);
+            original.updateWasDestroyed(priorDestroyed);
+            battlefield.add(original, Math.min(index, battlefield.size()), null, true);
+            for (Card item : equipment) {
+                if (game.getCardState(item, null) != item || !item.isInPlay()) {
+                    original.removeAttachedCard(item);
+                } else if (!item.isAttachedToEntity()) {
+                    item.setEntityAttachedTo(original);
+                    original.addAttachedCard(item);
+                } else if (item.getEntityAttachedTo() != original) {
+                    original.removeAttachedCard(item);
+                }
+            }
+            if (!equipment.isEmpty()) {
+                checkStaticAbilities(false);
+            }
+            game.updateLastStateForCard(original);
+            triggers.clearActiveTriggers(placed, null);
+            triggers.registerActiveTrigger(original, false);
+        });
         return result;
     }
 

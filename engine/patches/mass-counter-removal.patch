+package forge.ai.ability;
+
+import forge.ai.AiAbilityDecision;
+import forge.ai.SpellAbilityAi;
+import forge.ai.simulation.PaidOutcomePlanner;
+import forge.game.ability.effects.CharmEffect;
+import forge.game.player.Player;
+import forge.game.spellability.AbilitySub;
+import forge.game.spellability.SpellAbility;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Value counter removal together with its actual parent, native costs and aftermath. */
+public final class CountersRemoveAllAi extends SpellAbilityAi {
+    @Override
+    protected AiAbilityDecision checkApiLogic(Player actor, SpellAbility action) {
+        return PaidOutcomePlanner.choose(actor, action.getRootAbility());
+    }
+
+    @Override
+    public AiAbilityDecision chkDrawback(Player actor, SpellAbility action) {
+        return PaidOutcomePlanner.choose(actor, action.getRootAbility());
+    }
+
+    /** Assess a complete modal cast, not a free unattached mode or cleanup fragment. */
+    public static AiAbilityDecision assessMode(Player actor, SpellAbility root, AbilitySub mode) {
+        SpellAbility trial = root.copy();
+        trial.setActivatingPlayer(actor);
+        trial.setSubAbility(null);
+        List<AbilitySub> modes = new ArrayList<>();
+        modes.add((AbilitySub) mode.copy(actor));
+        trial.setChosenList(modes);
+        CharmEffect.chainAbilities(trial, modes);
+        return PaidOutcomePlanner.choose(actor, trial);
+    }
+}

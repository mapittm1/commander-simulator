@@ -0,0 +1,60 @@
+package forge.ai.ability;
+
+import forge.ai.AiAbilityDecision;
+import forge.ai.AiPlayDecision;
+import forge.ai.SpellAbilityAi;
+import forge.ai.simulation.PlayerControlPlanner;
+import forge.game.ability.AbilityUtils;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+/** Native-cost future evaluation for primary control actions; mandatory triggers retain native fallback. */
+public final class ControlPlayerAi extends SpellAbilityAi {
+    @Override
+    protected AiAbilityDecision checkApiLogic(Player ai, SpellAbility sa) {
+        if (PlayerControlPlanner.isEvaluating() || sa.isTrigger()) return new AiAbilityDecision(0, AiPlayDecision.AnotherTime);
+        Player selected = null;
+        int best = Integer.MIN_VALUE;
+        boolean completed = false;
+        List<Player> candidates = new ArrayList<>(ai.getGame().getPlayers());
+        candidates.sort(Comparator.comparingInt((Player player) -> player == ai ? -1 :
+                player.getCreaturesInPlay().stream().mapToInt(card -> Math.max(0, card.getNetPower())).sum()).reversed());
+        for (Player candidate : candidates) {
+            if (!sa.canTarget(candidate)) continue;
+            SpellAbility trial = sa.copy();
+            trial.resetTargets();
+            trial.getTargets().add(candidate);
+            PlayerControlPlanner.Assessment assessment = PlayerControlPlanner.assess(ai, trial);
+            completed |= assessment != null;
+            if (assessment != null && assessment.useful() && assessment.utility() > best) {
+                selected = candidate;
+                best = assessment.utility();
+                if (assessment.maximal()) break;
+            }
+        }
+        sa.resetTargets();
+        if (selected == null) return new AiAbilityDecision(0, completed ? AiPlayDecision.DoesntImpactGame : AiPlayDecision.AnotherTime);
+        sa.getTargets().add(selected);
+        return new AiAbilityDecision(100, AiPlayDecision.WillPlay);
+    }
+
+    @Override
+    public AiAbilityDecision chkDrawback(Player ai, SpellAbility sa) {
+        if (!sa.getConditions().areMet(sa)) return new AiAbilityDecision(100, AiPlayDecision.WillPlay);
+        if (sa.usesTargeting()) {
+            sa.resetTargets();
+            for (Player opponent : ai.getOpponents()) {
+                if (sa.canTarget(opponent)) {
+                    sa.getTargets().add(opponent);
+                    return new AiAbilityDecision(100, AiPlayDecision.WillPlay);
+                }
+            }
+            return new AiAbilityDecision(0, AiPlayDecision.TargetingFailed);
+        }
+        return new AiAbilityDecision(AbilityUtils.getDefinedPlayers(sa.getHostCard(), sa.getParam("Defined"), sa).isEmpty() ? 0 : 100,
+                AiPlayDecision.WillPlay);
+    }
+}

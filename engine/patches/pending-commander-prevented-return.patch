 public final class GameActionUtil {
+    /** Query only prohibitions; effects that replace a legal move remain allowed. */
+    public static boolean isZoneChangePrevented(Card card, ZoneType destination, SpellAbility cause) {
+        if (destination == null || card.getZone() == null) {
+            return false;
+        }
+        Map<AbilityKey, Object> parameters = AbilityKey.mapFromAffected(card);
+        parameters.put(AbilityKey.CardLKI, card);
+        parameters.put(AbilityKey.Origin, card.getZone().getZoneType());
+        parameters.put(AbilityKey.Destination, destination);
+        parameters.put(AbilityKey.Cause, cause);
+        parameters.put(AbilityKey.StackSa, cause);
+        parameters.put(AbilityKey.EffectOnly, true);
+        GameEntityCounterTable counters = new GameEntityCounterTable();
+        parameters.put(AbilityKey.CounterTable, counters);
+        parameters.put(AbilityKey.CounterMap, counters.column(card));
+        return card.getGame().getReplacementHandler().cantHappenCheck(ReplacementType.Moved, parameters);
+    }
+
 

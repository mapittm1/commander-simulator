+    private static CardCollection chooseManaSacrifices(SpellAbility manaAbility, CostSacrifice manaCost,
+            SpellAbility spell, List<CostSacrifice> spellCosts, Player payer, Set<Card> consumed,
+            List<CostTapType> tapGroups, Set<Card> unavailableForTaps) {
+        Card manaHost = manaAbility.getHostCard();
+        boolean distinctNames = manaCost.getType().contains("+WithDifferentNames");
+        CardCollection candidates;
+        if (manaCost.payCostFromSource()) {
+            candidates = new CardCollection(manaHost);
+        } else if (manaCost.getType().equals("OriginalHost")) {
+            candidates = new CardCollection(manaAbility.getOriginalHost());
+        } else {
+            String types = manaCost.getType().replace("+WithDifferentNames", "");
+            candidates = CardLists.getValidCards(payer.getCardsIn(ZoneType.Battlefield), types.split(";"),
+                    payer, manaHost, manaAbility);
+        }
+        candidates.removeIf(card -> consumed.contains(card) || spell.isTargeting(card)
+                || !card.canBeSacrificedBy(manaAbility, false));
+        int amount = manaCost.getAmount().equalsIgnoreCase("All") ? candidates.size() : manaCost.getAbilityAmount(manaAbility);
+        CardCollection selected = new CardCollection();
+        Set<String> usedNames = new HashSet<>();
+        Set<Card> unavailable = new HashSet<>(consumed);
+        Set<Card> untappable = new HashSet<>(unavailableForTaps);
+        untappable.addAll(consumed);
+
+        // Spare the other available mana sources where possible.
+        candidates.sort(Comparator.comparing(card -> !card.getManaAbilities().isEmpty()));
+        for (Card card : candidates) {
+            if (selected.size() == amount) {
+                break;
+            }
+            if (distinctNames && usedNames.contains(card.getName())) {
+                continue;
+            }
+            unavailable.add(card);
+            boolean addedTapExclusion = untappable.add(card);
+            if (canReserveSacrifices(spell, spellCosts, payer, unavailable)
+                    && reservesTapGroups(spell, payer, tapGroups, untappable)) {
+                selected.add(card);
+                usedNames.add(card.getName());
+            } else {
+                unavailable.remove(card);
+                if (addedTapExclusion) {
+                    untappable.remove(card);
+                }
+            }
+        }
+        return selected.size() == amount ? selected : null;
+    }
+
+    private static boolean canReserveSacrifices(SpellAbility spell, List<CostSacrifice> costs,
+            Player payer, Set<Card> unavailable) {
+        if (costs.isEmpty()) {
+            return true;
+        }
+        if (costs.size() == 1) {
+            return costs.get(0).canPayExcluding(spell, payer, false, unavailable);
+        }
+        return CostSacrifice.allocate(costs, spell, payer, false, unavailable) != null;
+    }

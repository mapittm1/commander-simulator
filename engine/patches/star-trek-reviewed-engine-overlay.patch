diff --git a/forge-ai/src/main/java/forge/ai/simulation/PaidOutcomePlanner.java b/forge-ai/src/main/java/forge/ai/simulation/PaidOutcomePlanner.java
new file mode 100644
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/simulation/PaidOutcomePlanner.java
@@ -0,0 +1,79 @@
+package forge.ai.simulation;
+
+import forge.ai.AiAbilityDecision;
+import forge.ai.AiPlayDecision;
+import forge.game.player.Player;
+import forge.game.spellability.AbilitySub;
+import forge.game.spellability.SpellAbility;
+import forge.util.AITimeoutTracker;
+import forge.util.MyRandom;
+import java.util.Random;
+
+/** Bounded paired native paid outcomes for complete spells and activated abilities. */
+public final class PaidOutcomePlanner {
+    private static final ThreadLocal<Boolean> ASSESSING = ThreadLocal.withInitial(() -> false);
+    private static final long[] SEEDS = {0L, 4096L};
+    private static final int MAX_TARGET_CHOICES = 128;
+
+    private PaidOutcomePlanner() { }
+
+    public static AiAbilityDecision choose(Player actor, SpellAbility action) {
+        if (ASSESSING.get() || action instanceof AbilitySub || action.isTrigger()
+                || actor.getGame().getStack().isResolving()) {
+            return new AiAbilityDecision(0, AiPlayDecision.AnotherTime);
+        }
+        ASSESSING.set(true);
+        try {
+            return MyRandom.withRandom(new Random(0L), () -> assess(actor, action));
+        } finally {
+            ASSESSING.remove();
+        }
+    }
+
+    private static AiAbilityDecision assess(Player actor, SpellAbility action) {
+        GameStateEvaluator.Score[] baseline = new GameStateEvaluator.Score[SEEDS.length];
+        long baselineValue = 0;
+        long baselineAvailable = 0;
+        for (int i = 0; i < SEEDS.length; i++) {
+            final long seed = SEEDS[i];
+            baseline[i] = MyRandom.withRandom(new Random(seed),
+                    () -> GameSimulator.scoreForDecision(actor.getGame(), actor));
+            baselineValue += baseline[i].value;
+            baselineAvailable += baseline[i].availableValue;
+        }
+        SpellAbility trial = action.copy();
+        MultiTargetSelector selector = new MultiTargetSelector(trial, null);
+        SpellAbility best = null;
+        long bestValue = baselineValue;
+        // An untargeted action has one empty target combination, not zero choices.
+        for (int choice = 0; choice < MAX_TARGET_CHOICES
+                && (selector.hasTargeting() ? selector.selectNextTargets() : choice == 0); choice++) {
+            AITimeoutTracker.check();
+            long value = 0;
+            long available = 0;
+            boolean complete = true;
+            for (int i = 0; i < SEEDS.length; i++) {
+                final long seed = SEEDS[i];
+                final GameStateEvaluator.Score start = baseline[i];
+                GameStateEvaluator.Score result = MyRandom.withRandom(new Random(seed), () -> {
+                    GameSimulator simulator = new GameSimulator(new SimulationController(start, 0), actor.getGame(), actor, null);
+                    return simulator.simulateSpellAbility(trial);
+                });
+                if (result.value == Integer.MIN_VALUE) {
+                    complete = false;
+                    break;
+                }
+                value += result.value;
+                available += result.availableValue;
+            }
+            if (complete && value > bestValue && available > baselineAvailable) {
+                best = trial.copy();
+                bestValue = value;
+            }
+        }
+        if (best == null) return new AiAbilityDecision(0, AiPlayDecision.DoesntImpactGame);
+        for (SpellAbility part = action; part != null; part = part.getSubAbility()) part.resetTargets();
+        SpellAbilityChoiceCopier.copyTargets(best, action, object -> object);
+        return new AiAbilityDecision(100, AiPlayDecision.WillPlay);
+    }
+}
diff --git a/forge-ai/src/main/java/forge/ai/simulation/PlayerControlPlanner.java b/forge-ai/src/main/java/forge/ai/simulation/PlayerControlPlanner.java
new file mode 100644
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/simulation/PlayerControlPlanner.java
@@ -0,0 +1,186 @@
+package forge.ai.simulation;
+
+import com.google.common.collect.Iterables;
+import forge.ai.ComputerUtil;
+import forge.ai.ComputerUtilCost;
+import forge.ai.PlayerControllerAi;
+import forge.game.Game;
+import forge.game.ability.ApiType;
+import forge.game.phase.PhaseType;
+import forge.game.player.Player;
+import forge.game.spellability.AbilitySub;
+import forge.game.spellability.SpellAbility;
+import forge.util.AITimeoutTracker;
+import forge.util.MyRandom;
+import java.util.Random;
+
+/** Paired native future windows for paid primary player-control actions. */
+public final class PlayerControlPlanner {
+    private static final int MAX_PLAYS_PER_MAIN = 2;
+    private static final int MAX_UTILITY = 100000;
+    private static final ThreadLocal<Boolean> EVALUATING = ThreadLocal.withInitial(() -> false);
+
+    private PlayerControlPlanner() { }
+
+    public static boolean isEvaluating() { return EVALUATING.get(); }
+
+    /** Native outcome flags accompany discounted terminal scores; MIN is a failed simulation. */
+    public record Window(GameStateEvaluator.Score score, boolean lost, boolean won) { }
+
+    public record Assessment(Window controlled, Window baseline) {
+        public int utility() {
+            if (controlled.lost()) return -MAX_UTILITY;
+            if (controlled.won() && !baseline.won()) return MAX_UTILITY;
+            if (baseline.lost()) return MAX_UTILITY;
+            return (int) Math.max(-MAX_UTILITY, Math.min(MAX_UTILITY,
+                    (long) controlled.score().value - baseline.score().value));
+        }
+
+        public boolean useful() { return !controlled.lost() && utility() >= 10; }
+        public boolean acceptable() { return !controlled.lost() && utility() >= 0; }
+        public boolean maximal() { return utility() == MAX_UTILITY; }
+
+        public GameStateEvaluator.Score relativeTo(GameStateEvaluator.Score current) {
+            if (controlled.lost() || controlled.won()) return controlled.score();
+            int value = (int) Math.max((long) Integer.MIN_VALUE + 1,
+                    Math.min((long) Integer.MAX_VALUE - 1, (long) current.value + utility()));
+            return new GameStateEvaluator.Score(value);
+        }
+    }
+
+    public static Assessment assess(Player actor, SpellAbility action) {
+        // The remaining continuation of a resolving parent is not a future window.
+        if (actor.getGame().getStack().isResolving()) return null;
+        return MyRandom.withRandom(new Random(0L), () -> assessScoped(actor, action));
+    }
+
+    private static Assessment assessScoped(Player actor, SpellAbility action) {
+        if (isEvaluating() || action.getApi() != ApiType.ControlPlayer || action.isTrigger()
+                || action instanceof AbilitySub || Iterables.size(action.getTargets().getTargetPlayers()) != 1
+                || !action.canPlay() || !ComputerUtilCost.canPayCost(action, actor, false)) return null;
+        final Player beneficiary = DecisionPerspective.beneficiary(actor);
+        final Random savedRandom = MyRandom.getRandom();
+        EVALUATING.set(true);
+        try {
+            MyRandom.setRandom(new Random(0L));
+            GameSimulator paid = new GameSimulator(actor.getGame(), actor, true);
+            if (!paid.applySpellAbility(action)) return null;
+            MyRandom.setRandom(new Random(0L));
+            SpellAbility played = paid.getLastPlayedAbility();
+            boolean combatWindow = combatOnly(played == null ? action : played);
+            Player target = paid.getGameCopier().find(Iterables.getOnlyElement(action.getTargets().getTargetPlayers()));
+            Player mappedBeneficiary = paid.getGameCopier().find(beneficiary);
+            Window controlled = finishWindow(paid.getSimulatedGameState(), target, mappedBeneficiary, combatWindow);
+            MyRandom.setRandom(new Random(0L));
+            GameSimulator baseline = new GameSimulator(actor.getGame(), actor, true);
+            Window ordinary = finishWindow(baseline.getSimulatedGameState(),
+                    baseline.getGameCopier().find(Iterables.getOnlyElement(action.getTargets().getTargetPlayers())),
+                    baseline.getGameCopier().find(beneficiary), combatWindow);
+            return controlled == null || ordinary == null ? null :
+                    new Assessment(controlled, ordinary);
+        } finally {
+            EVALUATING.remove();
+            MyRandom.setRandom(savedRandom);
+        }
+    }
+
+    /** Use already paid, interceptor-selected targets without mutating the action simulator. */
+    public static Assessment assessAfter(Game original, Player originalActor, Game paidGame,
+            Player paidActor, Player paidBeneficiary, SpellAbility action) {
+        if (action.getApi() != ApiType.ControlPlayer || isEvaluating()
+                || original.getStack().isResolving() || paidGame.getStack().isResolving()) return null;
+        return MyRandom.withRandom(new Random(0L), () -> assessAfterScoped(
+                original, originalActor, paidGame, paidActor, paidBeneficiary, action));
+    }
+
+    private static Assessment assessAfterScoped(Game original, Player originalActor, Game paidGame,
+            Player paidActor, Player paidBeneficiary, SpellAbility action) {
+        if (isEvaluating() || action.getApi() != ApiType.ControlPlayer || action.isTrigger()
+                || action instanceof AbilitySub || Iterables.size(action.getTargets().getTargetPlayers()) != 1) return null;
+        int targetSeat = paidGame.getRegisteredPlayers().indexOf(Iterables.getOnlyElement(action.getTargets().getTargetPlayers()));
+        int beneficiarySeat = paidGame.getRegisteredPlayers().indexOf(paidBeneficiary);
+        if (targetSeat < 0 || beneficiarySeat < 0) throw new IllegalStateException("Future control participant is not registered");
+        final Random savedRandom = MyRandom.getRandom();
+        EVALUATING.set(true);
+        try {
+            MyRandom.setRandom(new Random(0L));
+            GameSimulator paid = new GameSimulator(paidGame, paidActor, true);
+            Game controlledGame = paid.getSimulatedGameState();
+            Window controlled = finishWindow(controlledGame, controlledGame.getRegisteredPlayers().get(targetSeat),
+                    controlledGame.getRegisteredPlayers().get(beneficiarySeat), combatOnly(action));
+            MyRandom.setRandom(new Random(0L));
+            GameSimulator baseline = new GameSimulator(original, originalActor, true);
+            Game baselineGame = baseline.getSimulatedGameState();
+            Window ordinary = finishWindow(baselineGame, baselineGame.getRegisteredPlayers().get(targetSeat),
+                    baselineGame.getRegisteredPlayers().get(beneficiarySeat), combatOnly(action));
+            return controlled == null || ordinary == null ? null :
+                    new Assessment(controlled, ordinary);
+        } finally {
+            EVALUATING.remove();
+            MyRandom.setRandom(savedRandom);
+        }
+    }
+
+    private static boolean combatOnly(SpellAbility action) {
+        return action.hasParam("Combat") && action.getConditions().areMet(action);
+    }
+
+    private static void resolve(Game game, Player actor) {
+        if (game.isGameOver()) return;
+        Player opponent = actor.getWeakestOpponent();
+        GameSimulator.resolveStack(game, opponent == null ? actor : opponent);
+    }
+
+    private static Window outcome(Game game, Player beneficiary) {
+        return new Window(new GameStateEvaluator().getScoreForGameState(game, beneficiary),
+                beneficiary.hasLost(), beneficiary.hasWon());
+    }
+
+    private static Window finishWindow(Game game, Player target, Player beneficiary, boolean combat) {
+        final var phases = game.getPhaseHandler();
+        if (game.isGameOver() || beneficiary.hasLost()) return outcome(game, beneficiary);
+        boolean sameCombat = combat && phases.getPlayerTurn() == target && phases.getPhase().isBefore(PhaseType.COMBAT_BEGIN);
+        if (!sameCombat) {
+            int limit = game.getRegisteredPlayers().size() * 2 + 8;
+            do {
+                AITimeoutTracker.check();
+                if (--limit < 0 || phases.getPlayerTurn().isPhasesReversed()) return null;
+                if (!phases.devAdvanceThroughTurnEnd(PhaseType.MAIN1, () -> resolve(game, target))) {
+                    return game.isGameOver() || beneficiary.hasLost() ? outcome(game, beneficiary) : null;
+                }
+                if (beneficiary.hasLost()) return outcome(game, beneficiary);
+                if (!target.isInGame()) return null;
+            } while (phases.getPlayerTurn() != target);
+        }
+        if (!phases.is(PhaseType.MAIN1) || target.isPhasesReversed()) return null;
+        playMain(game, target);
+        if (!game.isGameOver() && target.isInGame()) {
+            if (!phases.devAdvanceToPhase(PhaseType.MAIN2, () -> resolve(game, target))) {
+                return game.isGameOver() || beneficiary.hasLost() ? outcome(game, beneficiary) : null;
+            }
+            playMain(game, target);
+        }
+        resolve(game, target);
+        if (!game.isGameOver() && !beneficiary.hasLost() && !phases.is(PhaseType.MAIN2)) return null;
+        return outcome(game, beneficiary);
+    }
+
+    private static void playMain(Game game, Player player) {
+        for (int play = 0; play < MAX_PLAYS_PER_MAIN && player.isInGame() && !game.isGameOver(); play++) {
+            AITimeoutTracker.check();
+            if (!(player.getController() instanceof PlayerControllerAi controller)) return;
+            // A future-window sample uses one-ply legal action search, not another
+            // recursively expanding full planning session for every sample.
+            SimulationController horizon = new SimulationController(GameSimulator.scoreForDecision(game, player), 0);
+            SpellAbility choice = controller.getAi().getSimulationPicker().chooseSpellAbilityToPlay(horizon);
+            if (choice == null) return;
+            if (choice.isLandAbility()) {
+                if (!choice.canPlay()) return;
+                player.playLand(choice.getHostCard(), choice);
+            } else if (!ComputerUtil.handlePlayingSpellAbility(player, choice, null)) {
+                return;
+            }
+            resolve(game, player);
+        }
+    }
+}

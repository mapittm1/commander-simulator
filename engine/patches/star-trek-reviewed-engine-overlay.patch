@@ -0,0 +1,49 @@
+package forge.ai.simulation;
+
+import forge.game.Game;
+import forge.game.ability.ApiType;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.trigger.WrappedAbility;
+import forge.util.MyRandom;
+import java.util.Random;
+
+/** Paired native suffixes at an exact optional-trigger resolution checkpoint. */
+public final class OptionalTriggerPlanner {
+    private static final ThreadLocal<Boolean> ASSESSING = ThreadLocal.withInitial(() -> false);
+
+    private OptionalTriggerPlanner() { }
+
+    public static Boolean choose(Player actor, WrappedAbility wrapper) {
+        Game game = actor.getGame();
+        SpellAbility action = wrapper.getWrappedAbility();
+        if (ASSESSING.get() || !game.getStack().isResolving()
+                || game.getStack().peekAbility() != wrapper || action.usesTargeting()
+                || action.getApi() != ApiType.ControlSpell || !"Exchange".equals(action.getParam("Mode"))) {
+            return null;
+        }
+        ASSESSING.set(true);
+        try {
+            Player beneficiary = DecisionPerspective.beneficiary(actor);
+            GameStateEvaluator.Score declined = project(game, actor, beneficiary, wrapper, false);
+            GameStateEvaluator.Score accepted = project(game, actor, beneficiary, wrapper, true);
+            return accepted.value > declined.value && accepted.availableValue > declined.availableValue;
+        } finally {
+            ASSESSING.remove();
+        }
+    }
+
+    private static GameStateEvaluator.Score project(Game source, Player actor, Player beneficiary,
+            WrappedAbility wrapper, boolean accepted) {
+        return MyRandom.withRandom(new Random(0L), () -> {
+            GameCopier copier = new GameCopier(source).withStack(true);
+            Game game = copier.makeCopy();
+            WrappedAbility copiedWrapper = copier.find(wrapper);
+            game.getStack().resumeOptionalTriggerCheckpoint(copiedWrapper, accepted);
+            Player copiedActor = copier.find(actor);
+            Player resolver = copiedActor.getWeakestOpponent();
+            GameSimulator.resolveStack(game, resolver == null ? copiedActor : resolver);
+            return new GameStateEvaluator().getScoreForGameState(game, copier.find(beneficiary));
+        });
+    }

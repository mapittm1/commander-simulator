new file mode 100644
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/simulation/DecisionPerspective.java
@@ -0,0 +1,27 @@
+package forge.ai.simulation;
+
+import forge.game.player.Player;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.Set;
+
+/** Resolve the decision beneficiary without changing the actor's ownership or resources. */
+public final class DecisionPerspective {
+    private DecisionPerspective() {}
+
+    public static Player beneficiary(Player actor) {
+        Set<Player> visited = Collections.newSetFromMap(new IdentityHashMap<>());
+        Player current = actor;
+        while (visited.add(current)) {
+            Player master = current.getControllingPlayer();
+            if (master == null || master == current) {
+                return current;
+            }
+            if (master.getGame() != actor.getGame()) {
+                throw new IllegalStateException("Decision controller belongs to a different game");
+            }
+            current = master;
+        }
+        throw new IllegalStateException("Cyclic player control has no unique decision beneficiary");
+    }
+}

+
+/** Restrict shared paid-outcome planning to complete compound stack responses. */
+public final class StackResponsePlanner {
+    private StackResponsePlanner() { }
+
+    public static boolean targetsStack(SpellAbility action) {
+        return action.usesTargeting() && action.getTargetRestrictions().getZone().contains(ZoneType.Stack);
+    }
+
+    public static AiAbilityDecision choose(Player actor, SpellAbility action) {
+        if (!targetsStack(action)) return new AiAbilityDecision(0, AiPlayDecision.AnotherTime);
+        return PaidOutcomePlanner.choose(actor, action);
+    }
+}

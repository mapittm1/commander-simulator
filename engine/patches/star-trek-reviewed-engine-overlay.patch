+    private static void payProjectedMana(ManaCostBeingPaid cost, Player payer, SpellAbility payingFor,
+            SpellAbility source, String produced, int multiplier) {
+        Card host = source.getHostCard();
+        AbilityManaPart part = source.getManaPart();
+        if (part == null || !part.meetsManaRestrictions(payingFor)) {
+            return;
+        }
+        for (String symbol : TextUtil.split(produced, ' ')) {
+            int amount = StringUtils.isNumeric(symbol) ? Integer.parseInt(symbol) : 1;
+            byte color = ManaAtom.fromName(symbol);
+            if (color == 0) {
+                color = (byte) ManaAtom.COLORLESS;
+            }
+            if (!payingFor.allowsPayingWithShard(host, color)) {
+                continue;
+            }
+            for (int count = 0; count < amount * multiplier; count++) {
+                if (!cost.payProjectedMana(color, host.isSnow(), part, payer.getManaPool())) {
+                    break;
+                }
+            }
+        }
+    }
+
+    private static String chooseReflectedType(Collection<String> available, ManaCostBeingPaid remaining,
+            Player payer, SpellAbility payingFor, SpellAbility effect) {
+        String choice = available.iterator().next();
+        int bestMana = Integer.MAX_VALUE;
+        int bestColored = Integer.MAX_VALUE;
+        for (String option : available) {
+            ManaCostBeingPaid candidate = new ManaCostBeingPaid(remaining);
+            payProjectedMana(candidate, payer, payingFor, effect, option, 1);
+            int total = candidate.getConvertedManaCost();
+            int colored = total - candidate.getGenericManaAmount();
+            if (total < bestMana || (total == bestMana && colored < bestColored)) {
+                choice = option;
+                bestMana = total;
+                bestColored = colored;
+            }
+        }
+        return choice;
+    }
+
+    private static void resolveManaAbility(SpellAbility source, SpellAbility payingFor,
+            ManaCostBeingPaid cost, Player payer) {
+        AbilityManaPart manaPart = source.getManaPart();
+        var previousChoice = manaPart.setReflectedManaChoice((recipient, effect, available) -> recipient == payer
+                ? chooseReflectedTypeForPayment(available, cost, payingFor, payer, effect) : null);
+        try {
+            payer.getGame().getStack().addAndUnfreeze(source);
+        } finally {
+            manaPart.setReflectedManaChoice(previousChoice);
+        }
+    }
+
+    private static String chooseReflectedTypeForPayment(Collection<String> available, ManaCostBeingPaid cost,
+            SpellAbility payingFor, Player payer, SpellAbility effect) {
+        ManaPool pool = payer.getManaPool();
+        ManaCostBeingPaid remaining = new ManaCostBeingPaid(cost);
+        for (Mana mana : pool) {
+            if (remaining.isNeeded(mana, pool) && mana.meetsManaRestrictions(payingFor)
+                    && payingFor.allowsPayingWithShard(mana.getSourceCard(), mana.getColor())) {
+                remaining.payMana(mana, pool);
+            }
+        }
+        return chooseReflectedType(available, remaining, payer, payingFor, effect);
     }
 

+    private static void projectManaTriggers(TriggerType event, Map<AbilityKey, Object> runParams,
+            SpellAbility payingFor, Player payer, ManaCostBeingPaid cost, String sourceMana) {
+        for (Trigger tr : payer.getGame().getTriggerHandler().getActiveTrigger(event, runParams)) {
+            SpellAbility template = tr.ensureAbility();
+            if (!tr.isStatic() || template == null || !isProjectedManaEffect(template)) {
+                continue;
+            }
+
+            // Bind conditions and definitions to this payment without changing the trigger template.
+            Card triggerHost = tr.getHostCard();
+            SpellAbility trigger = template.copy(triggerHost, triggerHost.getController(), false, true);
+            trigger.setTrigger(tr);
+            trigger.setTriggeringObjects(tr.buildTriggeringObjects(runParams));
+            if (tr.hasParam("OptionalDecider")
+                    && !AbilityUtils.getDefinedPlayers(triggerHost, tr.getParam("OptionalDecider"), trigger).contains(payer)) {
+                continue;
+            }
+            for (SpellAbility effect = trigger; effect != null && isProjectedManaEffect(effect);
+                    effect = effect.getSubAbility()) {
+                projectManaEffect(effect, payingFor, payer, cost, sourceMana);
+            }
+        }
+    }
+
+    private static boolean isProjectedManaEffect(SpellAbility effect) {
+        return effect.getApi() == ApiType.Mana || effect.getApi() == ApiType.ManaReflected
+                || effect.getApi() == ApiType.RepeatEach && effect.hasParam("RepeatCards");
+    }
+
+    private static void projectManaEffect(SpellAbility effect, SpellAbility payingFor,
+            Player payer, ManaCostBeingPaid cost, String landMana) {
+        if (!effect.metConditions() || effect.usesTargeting() || effect.hasParam("UnlessCost")) {
+            return;
+        }

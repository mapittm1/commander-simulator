     protected final ZoneType zoneType;
     protected final Game game;
     private long libraryOrderRevision;
+    private transient List<LibraryObservation> libraryObservations;
+
+    /** A bounded live scope proves that cards outside an inspected prefix were not mutated. */
+    public final class LibraryObservation implements AutoCloseable {
+        private final long previousRevision = libraryOrderRevision;
+        private final int previousSize = cardList.size();
+        private final int inspectedCount;
+        private final Map<Integer, Card> inspected = Maps.newHashMap();
+        private boolean unchanged = true;
+        private boolean closed;
+
+        private LibraryObservation(CardCollectionView prefix) {
+            inspectedCount = prefix.size();
+            if (zoneType != ZoneType.Library || inspectedCount > previousSize) unchanged = false;
+            for (int index = 0; index < prefix.size(); index++) {
+                Card card = prefix.get(index);
+                if (index >= previousSize || card.getGame() != game || card.getZone() != Zone.this
+                        || card != cardList.get(index)) unchanged = false;
+                else inspected.put(card.getId(), card);
+            }
+        }
+
+        public long previousRevision() { return previousRevision; }
+        public int previousSize() { return previousSize; }
+        public int inspectedCount() { return inspectedCount; }
+        public boolean isFor(Zone zone) { return Zone.this == zone; }
+        public boolean preservesOutside() { return unchanged && !closed; }
+        public boolean permits(Card card) {
+            // Same-library placement refreshes timestamps but retains the exact inspected object.
+            // A replacement/copy that merely reuses its ID must not inherit this authorization.
+            return inspected.get(card.getId()) == card;
+        }
+        @Override public void close() {
+            if (!closed) {
+                closed = true;
+                if (libraryObservations != null) libraryObservations.remove(this);
+            }
+        }
+    }
+
+    public final LibraryObservation beginLibraryObservation(CardCollectionView prefix) {
+        LibraryObservation observation = new LibraryObservation(prefix);
+        if (libraryObservations == null) libraryObservations = Lists.newArrayList();
+        if (libraryObservations.size() >= 64) {
+            invalidateLibraryObservations();
+            observation.unchanged = false;
+        } else {
+            libraryObservations.add(observation);
+        }
+        return observation;
+    }
+
+    private void invalidateLibraryObservations() {
+        if (libraryObservations != null) {
+            for (LibraryObservation observation : libraryObservations) observation.unchanged = false;
+        }
+    }
+
+    private void changedLibraryOrder(Card moved) {
+        if (zoneType == ZoneType.Library) {
+            libraryOrderRevision++;
+            if (libraryObservations != null) {
+                for (LibraryObservation observation : libraryObservations) {
+                    if (!observation.permits(moved)) observation.unchanged = false;
+                }
+            }
+        }
+    }
 

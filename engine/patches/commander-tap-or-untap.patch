     // stores result + args as vector
     private final static Multimap<String, List<Object>> dataMap = Multimaps.synchronizedMultimap(ArrayListMultimap.create());
 
+    private static final ThreadLocal<Multimap<String, List<Object>>> previewCache = new ThreadLocal<>();
+
+    /** Keep projected game references out of the live decision cache, even on failed previews. */
+    public static <T> T withIsolatedCache(Supplier<T> action) {
+        Multimap<String, List<Object>> previous = previewCache.get();
+        previewCache.set(ArrayListMultimap.create());
+        try {
+            return action.get();
+        } finally {
+            if (previous == null) previewCache.remove();
+            else previewCache.set(previous);
+        }
+    }
+
+    private static Multimap<String, List<Object>> activeCache() {
+        Multimap<String, List<Object>> scoped = previewCache.get();
+        return scoped == null ? dataMap : scoped;
+    }

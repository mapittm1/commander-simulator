+    private static boolean reservesTapGroups(SpellAbility payingFor, Player payer, List<CostTapType> groups,
+            Set<Card> unavailable) {
+        return groups.stream().allMatch(group -> group.canPayExcluding(payingFor, payer, unavailable));
+    }
+
+    private static CardCollection chooseManaTaps(SpellAbility manaAbility, CostTapType manaTapCost,
+            SpellAbility payingFor, List<CostTapType> groups, Player payer, Set<Card> unavailable) {
+        int amount = manaTapCost.getAbilityAmount(manaAbility);
+        CardCollection candidates = manaTapCost.getTapCandidates(payer, manaAbility);
+        candidates.removeAll(unavailable);
+        CardLists.sortByPowerAsc(candidates);
+        Set<Card> used = new HashSet<>(unavailable);
+        CardCollection selected = new CardCollection();
+        for (Card candidate : candidates) {
+            if (selected.size() == amount) {
+                break;
+            }
+            used.add(candidate);
+            if (reservesTapGroups(payingFor, payer, groups, used)) {
+                selected.add(candidate);
+            } else {
+                used.remove(candidate);
+            }
+        }
+        return selected.size() == amount ? selected : null;
+    }

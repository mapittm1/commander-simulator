+    private static ManaResourcePlan planManaResources(SpellAbility manaAbility, SpellAbility payingFor, Player payer,
+            List<CostSacrifice> sacrificeCosts, List<CostTapType> tapGroups,
+            Set<Card> projectedTaps, Set<Card> consumed) {
+        if (sacrificeCosts.isEmpty() && tapGroups.isEmpty()) {
+            return ManaResourcePlan.EMPTY;
+        }
+        Set<Card> unavailableForTaps = new HashSet<>();
+        CardCollection manaTaps = null;
+        if (!tapGroups.isEmpty()) {
+            unavailableForTaps.addAll(projectedTaps);
+            unavailableForTaps.addAll(consumed);
+            if (payingFor.getPayCosts().hasTapCost()) {
+                unavailableForTaps.add(payingFor.getHostCard());
+            }
+            if (manaAbility.getPayCosts().hasTapCost()) {
+                unavailableForTaps.add(manaAbility.getHostCard());
+            }
+            if (!reservesTapGroups(payingFor, payer, tapGroups, unavailableForTaps)) {
+                return null;
+            }
+            CostTapType manaTapCost = manaAbility.getPayCosts().getCostPartByType(CostTapType.class);
+            if (manaTapCost != null) {
+                manaTaps = chooseManaTaps(manaAbility, manaTapCost, payingFor, tapGroups, payer, unavailableForTaps);
+                if (manaTaps == null) {
+                    return null;
+                }
+                unavailableForTaps.addAll(manaTaps);
+            }
+        }
+
+        CardCollection manaSacrifices = null;
+        if (!sacrificeCosts.isEmpty() || !tapGroups.isEmpty()) {
+            CostSacrifice manaCost = manaAbility.getPayCosts().getCostPartByType(CostSacrifice.class);
+            if (manaCost != null) {
+                manaSacrifices = chooseManaSacrifices(manaAbility, manaCost, payingFor, sacrificeCosts, payer,
+                        consumed, tapGroups, unavailableForTaps);
+                if (manaSacrifices == null) {
+                    return null;
+                }
+            }
+        }
+        return new ManaResourcePlan(manaTaps, manaSacrifices);
+    }

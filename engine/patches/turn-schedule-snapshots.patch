+    /** Retain scheduler state and stack order without adding turns or replaying phase hooks. */
+    public void copySnapshotStateFrom(PhaseHandler original,
+            forge.game.spellability.SpellAbilitySnapshot context) {
+        extraTurns.clear();
+        for (ExtraTurn extra : original.extraTurns) {
+            extraTurns.add(context.extraTurn(extra));
+        }
+        extraPhases.clear();
+        for (Map.Entry<PhaseType, Stack<ExtraPhase>> entry : original.extraPhases.entrySet()) {
+            Stack<ExtraPhase> copied = new Stack<>();
+            for (ExtraPhase extra : entry.getValue()) {
+                copied.add(context.extraPhase(extra));
+            }
+            extraPhases.put(entry.getKey(), copied);
+        }
+        nUpkeepsThisTurn = original.nUpkeepsThisTurn;
+        nUpkeepsThisGame = original.nUpkeepsThisGame;
+        nCombatsThisTurn = original.nCombatsThisTurn;
+        nMainsThisTurn = original.nMainsThisTurn;
+        nEndOfTurnsThisTurn = original.nEndOfTurnsThisTurn;
+        planarDiceSpecialActionThisTurn = original.planarDiceSpecialActionThisTurn;
+        playerPreviousTurn = context.map(original.playerPreviousTurn);
+        pPlayerPriority = context.map(original.pPlayerPriority);
+        pFirstPriority = context.map(original.pFirstPriority);
+        skipDamageSteps = original.skipDamageSteps;
+        bRepeatCleanup = original.bRepeatCleanup;
+        givePriorityToPlayer = original.givePriorityToPlayer;
+        for (Player player : original.game.getRegisteredPlayers()) {
+            Player copied = context.map(player);
+            copied.setExtraTurn(player.isExtraTurn());
+            copied.setExtraTurnCount(player.getExtraTurnCount());
+        }
+    }
+
 }

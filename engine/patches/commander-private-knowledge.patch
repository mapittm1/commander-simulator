+    public void observeLibraryDraw(PlayerController.LibraryDraw draw) {
+        LibraryKnowledge known = libraryKnowledge.remove(draw.owner());
+        if (known == null || known.owner() != draw.owner() || known.revision() != draw.previousRevision()) {
+            return;
+        }
+        long revision = draw.owner().getZone(ZoneType.Library).getLibraryOrderRevision();
+        if (revision != draw.previousRevision() + 1
+                || draw.owner().getCardsIn(ZoneType.Library).size() != draw.previousSize() - 1) {
+            return;
+        }
+        CardIdentity expected = known.positions().get(draw.index());
+        if (expected != null) {
+            if (expected.id() != draw.previousCardId() || expected.timestamp() != draw.previousCardTimestamp()
+                    || draw.drawn().getId() != expected.id()) {
+                return;
+            }
+            rememberCard(draw.drawn(), MemorySet.REVEALED_CARDS);
+        }
+        Map<Integer, CardIdentity> remaining = Maps.newHashMap();
+        for (Map.Entry<Integer, CardIdentity> entry : known.positions().entrySet()) {
+            if (entry.getKey() != draw.index()) {
+                remaining.put(entry.getKey() > draw.index() ? entry.getKey() - 1 : entry.getKey(), entry.getValue());
+            }
+        }
+        if (!remaining.isEmpty()) {
+            libraryKnowledge.put(draw.owner(), new LibraryKnowledge(draw.owner(), revision, remaining));
+        }
+    }

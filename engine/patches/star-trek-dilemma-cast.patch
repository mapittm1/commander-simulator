+
+    private static final class PendingDilemma {
+        private final Player chooser;
+        private final TriggerWaiting trigger;
+        private boolean settled;
+
+        private PendingDilemma(Player chooser, TriggerWaiting trigger) {
+            this.chooser = chooser;
+            this.trigger = trigger;
+        }
+    }
+
+    private transient PendingDilemma pendingDilemma;
+
+    public void stageDilemma(Player chooser, Map<AbilityKey, Object> params) {
+        rollbackDilemma();
+        chooser.incDilemmasFacedThisTurn();
+        TriggerWaiting trigger = chooser.getGame().getTriggerHandler()
+                .holdPaymentTrigger(TriggerType.FacesDilemma, params);
+        pendingDilemma = new PendingDilemma(chooser, trigger);
+    }
+
+    public void commitDilemma() {
+        PendingDilemma recorded = settleDilemma();
+        if (recorded != null && recorded.trigger != null) {
+            recorded.chooser.getGame().getTriggerHandler().commitPaymentTrigger(recorded.trigger);
+        }
+    }
+
+    public void rollbackDilemma() {
+        PendingDilemma recorded = settleDilemma();
+        if (recorded != null) {
+            recorded.chooser.setDilemmasFacedThisTurn(recorded.chooser.getDilemmasFacedThisTurn() - 1);
+        }
+    }
+
+    public void clearDilemmaAfterSnapshotRestore() {
+        settleDilemma();
+    }
+
+    private PendingDilemma settleDilemma() {
+        PendingDilemma recorded = pendingDilemma;
+        pendingDilemma = null;
+        // Same-game cast copies can share the receipt. A simulated game may never settle it.
+        if (recorded == null || recorded.settled || recorded.chooser.getGame() != getHostCard().getGame()) {
+            return null;
+        }
+        recorded.settled = true;
+        return recorded;
+    }
+
     public void setTriggeringObjects(final Map<AbilityKey, Object> triggeredObjects) {
         triggeringObjects = AbilityKey.newMap(triggeredObjects);
     }

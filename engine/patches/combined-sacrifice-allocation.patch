+    /** Allocate separate physical cards to all outstanding sacrifice requirements. */
+    public static Map<CostSacrifice, CardCollection> allocate(List<CostSacrifice> costs,
+            SpellAbility ability, Player payer, boolean effect, Set<Card> unavailable) {
+        List<List<AllocationEdge>> graph = new ArrayList<>();
+        int source = addNode(graph);
+        int sink = addNode(graph);
+        Map<Card, Integer> cardNodes = new LinkedHashMap<>();
+        Map<CostSacrifice, Map<Card, AllocationEdge>> choices = new LinkedHashMap<>();
+        int required = 0;
+        for (CostSacrifice cost : costs) {
+            if (!cost.canPayExcluding(ability, payer, effect, unavailable)) {
+                return null;
+            }
+            CardCollection eligible = cost.candidates(ability, payer, effect, unavailable);
+            int amount = cost.amountFor(ability, eligible);
+            int requirement = addNode(graph);
+            connect(graph, source, requirement, amount);
+            required += amount;
+            Map<String, Integer> nameNodes = new LinkedHashMap<>();
+            Map<Card, AllocationEdge> edges = new LinkedHashMap<>();
+            choices.put(cost, edges);
+            for (Card card : eligible) {
+                int from = requirement;
+                if (cost.distinctNames()) {
+                    from = nameNodes.computeIfAbsent(card.getName(), name -> {
+                        int node = addNode(graph);
+                        connect(graph, requirement, node, 1);
+                        return node;
+                    });
+                }
+                int to = cardNodes.computeIfAbsent(card, key -> {
+                    int node = addNode(graph);
+                    connect(graph, node, sink, 1);
+                    return node;
+                });
+                edges.put(card, connect(graph, from, to, 1));
+            }
+        }
+        if (required > cardNodes.size()) {
+            return null;
+        }
+        for (int count = 0; count < required; count++) {
+            if (!augment(graph, source, sink)) {
+                return null;
+            }
+        }
+        Map<CostSacrifice, CardCollection> result = new LinkedHashMap<>();
+        choices.forEach((cost, edges) -> {
+            CardCollection selected = new CardCollection();
+            edges.forEach((card, edge) -> {
+                if (edge.capacity == 0) {
+                    selected.add(card);
+                }
+            });
+            result.put(cost, selected);
+        });
+        return result;
+    }
+
+    private static int addNode(List<List<AllocationEdge>> graph) {
+        graph.add(new ArrayList<>());
+        return graph.size() - 1;
+    }
+
+    private static AllocationEdge connect(List<List<AllocationEdge>> graph, int from, int to, int capacity) {
+        AllocationEdge forward = new AllocationEdge(to, graph.get(to).size(), capacity);
+        AllocationEdge reverse = new AllocationEdge(from, graph.get(from).size(), 0);
+        graph.get(from).add(forward);
+        graph.get(to).add(reverse);
+        return forward;
+    }
+
+    private static boolean augment(List<List<AllocationEdge>> graph, int source, int sink) {
+        AllocationEdge[] previous = new AllocationEdge[graph.size()];
+        boolean[] visited = new boolean[graph.size()];
+        ArrayDeque<Integer> queue = new ArrayDeque<>();
+        queue.add(source);
+        visited[source] = true;
+        while (!queue.isEmpty() && !visited[sink]) {
+            int node = queue.remove();
+            for (AllocationEdge edge : graph.get(node)) {
+                if (edge.capacity > 0 && !visited[edge.to]) {
+                    visited[edge.to] = true;
+                    previous[edge.to] = edge;
+                    queue.add(edge.to);
+                }
+            }
+        }
+        if (!visited[sink]) {
+            return false;
+        }
+        for (int node = sink; node != source;) {
+            AllocationEdge edge = previous[node];
+            AllocationEdge reverse = graph.get(node).get(edge.reverse);
+            edge.capacity--;
+            reverse.capacity++;
+            node = reverse.to;
+        }
+        return true;
+    }
+
+    private static final class AllocationEdge {
+        private final int to;
+        private final int reverse;
+        private int capacity;
+
+        private AllocationEdge(int to, int reverse, int capacity) {
+            this.to = to;
+            this.reverse = reverse;
+            this.capacity = capacity;
+        }
     }
 

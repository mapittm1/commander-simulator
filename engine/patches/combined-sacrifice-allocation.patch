+    public boolean selectedCardsAvailable(Player payer, PaymentDecision decision, SpellAbility ability, boolean effect) {
+        if (decision == null || decision.cards == null || !canPay(ability, payer, effect)) {
+            return false;
+        }
+        CardCollection eligible = candidates(ability, payer, effect, Set.of());
+        if (decision.cards.size() != amountFor(ability, eligible)
+                || distinctNames() && CardLists.getDifferentNamesCount(decision.cards) != decision.cards.size()) {
+            return false;
+        }
+        return decision.cards.stream().allMatch(card -> eligible.stream().anyMatch(available -> available == card));
+    }

+    /** Resolve each deferred repeat against references in the queue's own world. */
+    private static final class RepeatForPlayerCommand implements SnapshotCommand {
+        private static final long serialVersionUID = 1L;
+        private final Card source;
+        private final Player player;
+        private final SpellAbility repeat;
+
+        private RepeatForPlayerCommand(final Card source, final Player player, final SpellAbility repeat) {
+            this.source = source;
+            this.player = player;
+            this.repeat = repeat;
+        }
+
+        @Override
+        public void run() {
+            List<Object> tempRemembered = Lists.newArrayList(IterableUtil.filter(source.getRemembered(), Player.class));
+            source.removeRemembered(tempRemembered);
+            source.addRemembered(player);
+            AbilityUtils.resolve(repeat);
+            source.removeRemembered(player);
+            source.addRemembered(tempRemembered);
+        }
+
+        @Override
+        public SnapshotCommand copyForSnapshot(final SpellAbilitySnapshot context) {
+            return new RepeatForPlayerCommand(context.map(source), context.map(player), context.copy(repeat));
+        }
+    }

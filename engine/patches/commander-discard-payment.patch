diff --git a/forge-ai/src/main/java/forge/ai/simulation/DiscardPaymentChoices.java b/forge-ai/src/main/java/forge/ai/simulation/DiscardPaymentChoices.java
new file mode 100644
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/simulation/DiscardPaymentChoices.java
@@ -0,0 +1,159 @@
+package forge.ai.simulation;
+
+import forge.game.GameObject;
+import forge.game.card.Card;
+import forge.game.card.CardCollection;
+import forge.game.card.CardCollectionView;
+import forge.game.cost.CostDiscard;
+import forge.game.cost.CostPart;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+import forge.util.AITimeoutTracker;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+
+/** Bounded single-card discard choices for paid activated-ability previews and replay. */
+public final class DiscardPaymentChoices {
+    private static final String KEY = "AIPaidDiscard";
+    private static final int MAX_CHOICES = 32;
+    private DiscardPaymentChoices() { }
+
+    private static CostDiscard simpleDiscard(SpellAbility action) {
+        if (!action.isActivatedAbility() || action.getPayCosts() == null) return null;
+        CostDiscard result = null;
+        for (CostPart part : action.getPayCosts().getCostParts()) {
+            if (part instanceof CostDiscard discard) {
+                if (result != null || discard.payCostFromSource() || !"Card".equals(discard.getType())
+                        || discard.getAbilityAmount(action) != 1) return null;
+                result = discard;
+            }
+        }
+        return result;
+    }
+
+    private static String cardStamp(Card card) {
+        return card.getId() + "@" + card.getGameTimestamp();
+    }
+
+    private static String binding(SpellAbility action) {
+        Player actor = action.getActivatingPlayer();
+        if (actor == null) return null;
+        StringBuilder result = new StringBuilder(actor.getId() + ":" + cardStamp(action.getHostCard()) + ":" + action.getApi());
+        for (SpellAbility part = action; part != null; part = part.getSubAbility()) {
+            result.append("[");
+            for (GameObject target : part.getTargets()) {
+                if (target instanceof Card card) result.append("C").append(cardStamp(card));
+                else if (target instanceof Player player) result.append("P").append(player.getId());
+                else return null;
+                result.append(",");
+            }
+            result.append("]");
+        }
+        return result.append(":").toString();
+    }
+
+    public static List<SpellAbility> variants(SpellAbility action) {
+        CostDiscard cost = simpleDiscard(action);
+        if (cost == null) return List.of(action);
+        SpellAbility ordinary = action.copy(); clearPlan(ordinary);
+        String owner = binding(ordinary);
+        if (owner == null) return List.of(ordinary);
+        List<SpellAbility> result = new ArrayList<>(); result.add(ordinary);
+        for (String choice : paymentOptions(ordinary.getActivatingPlayer(), ordinary, cost, false, CardCollection.EMPTY)) {
+            SpellAbility trial = ordinary.copy(); installPlan(trial, choice); result.add(trial);
+        }
+        return result;
+    }
+
+    public static List<String> paymentOptions(Player payer, SpellAbility action, CostDiscard cost,
+            boolean effect, CardCollectionView excluded) {
+        SpellAbility root = action.getRootAbility();
+        if (!payer.equals(root.getActivatingPlayer()) || simpleDiscard(root) == null
+                || cost.payCostFromSource() || !"Card".equals(cost.getType())
+                || cost.getAbilityAmount(action) != 1 || !cost.canPay(action, payer, effect)) return List.of();
+        String owner = binding(root); if (owner == null) return List.of();
+        List<String> result = new ArrayList<>();
+        for (Card card : payer.getCardsIn(ZoneType.Hand)) {
+            AITimeoutTracker.check();
+            if (card.equals(root.getHostCard()) && card.isInZone(ZoneType.Hand) && payer.equals(card.getOwner())) continue;
+            if (excluded.contains(card) || !card.canBeDiscardedBy(action, effect)) continue;
+            result.add(owner + cardStamp(card));
+            // Keep the native payment policy rather than silently dropping legal choices.
+            if (result.size() > MAX_CHOICES) return List.of();
+        }
+        return result;
+    }
+
+    public static String plannedChoice(SpellAbility action) {
+        return action.getRootAbility().getPlannedAiChoice(KEY);
+    }
+
+    public static void installPlan(SpellAbility action, String choice) {
+        if (choice == null) clearPlan(action);
+        else action.getRootAbility().setPlannedAiChoice(KEY, choice);
+    }
+
+    public static boolean hasPlan(SpellAbility action) {
+        return action != null && action.getRootAbility().getPlannedAiChoice(KEY) != null;
+    }
+
+    /** Consume an internal choice only after rechecking native payment legality and identities. */
+    public static Card takePlannedCard(Player payer, SpellAbility action, CostDiscard cost,
+            boolean effect, CardCollectionView excluded) {
+        Card selected = selectedCard(payer, action, cost, effect, excluded, false);
+        clearPlan(action);
+        return selected;
+    }
+
+    public static Card peekPlannedCard(Player payer, SpellAbility action, CostDiscard cost,
+            boolean effect, CardCollectionView excluded) {
+        return selectedCard(payer, action, cost, effect, excluded, true);
+    }
+
+    private static boolean referencesCurrent(SpellAbility action) {
+        Card host = action.getHostCard();
+        Card currentHost = host.getGame().getCardState(host, null);
+        if (currentHost == null || !host.equalsWithGameTimestamp(currentHost)) return false;
+        for (SpellAbility part = action; part != null; part = part.getSubAbility()) {
+            if (part.usesTargeting() && !part.isTargetNumberValid()) return false;
+            for (GameObject target : part.getTargets()) {
+                if (target instanceof Card card) {
+                    Card current = host.getGame().getCardState(card, null);
+                    if (current == null || !card.equalsWithGameTimestamp(current)
+                            || (part.usesTargeting() && !part.canTarget(current))) return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    private static Card selectedCard(Player payer, SpellAbility action, CostDiscard cost,
+            boolean effect, CardCollectionView excluded, boolean beforePayment) {
+        SpellAbility root = action.getRootAbility();
+        if (beforePayment && !referencesCurrent(root)) return null;
+        String planned = root.getPlannedAiChoice(KEY);
+        if (planned == null || !payer.equals(root.getActivatingPlayer())
+                || root.getHostCard().getGame() != payer.getGame()
+                || simpleDiscard(root) == null || cost.payCostFromSource()
+                || !"Card".equals(cost.getType()) || cost.getAbilityAmount(action) != 1
+                || !cost.canPay(action, payer, effect)) return null;
+        String owner = binding(root); if (owner == null) return null;
+        for (Card card : payer.getCardsIn(ZoneType.Hand)) {
+            if (!excluded.contains(card) && Objects.equals(planned, owner + cardStamp(card))
+                    && card.canBeDiscardedBy(action, effect)) return card;
+        }
+        return null;
+    }
+
+    static void clearPlan(SpellAbility action) {
+        action.getRootAbility().clearPlannedAiChoice(KEY);
+    }
+
+    static void copyPlan(SpellAbility source, SpellAbility destination) {
+        destination.clearPlannedAiChoice(KEY);
+        String planned = source.getPlannedAiChoice(KEY);
+        if (planned != null) destination.setPlannedAiChoice(KEY, planned);
+    }
+}

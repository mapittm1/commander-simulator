+    /** Resolve a text effect's explicit parent target, including spells on the stack. */
+    public static List<Card> getTextTargets(final SpellAbility action) {
+        if (!action.usesTargeting() && "ParentTarget".equals(action.getParam("Defined"))) {
+            for (SpellAbility parent = action.getParent(); parent != null; parent = parent.getParent()) {
+                if (parent.getTargets().isTargetingAnyCard() || parent.getTargets().isTargetingAnySpell()) {
+                    return getCardsfromTargets(parent);
+                }
+            }
+        }
+        return getCardsfromTargets(action);
+    }
 

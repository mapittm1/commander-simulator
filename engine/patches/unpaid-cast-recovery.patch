diff --git a/forge-game/src/main/java/forge/game/trigger/TriggerHandler.java b/forge-game/src/main/java/forge/game/trigger/TriggerHandler.java
--- a/forge-game/src/main/java/forge/game/trigger/TriggerHandler.java
+++ b/forge-game/src/main/java/forge/game/trigger/TriggerHandler.java
@@ -185,16 +185,40 @@
                 continue;
             }
 
-            // TODO we don't seem to handle Static ones from this,
-            // so they shouldn't be checked for performance in the first place
-            wt.setTriggers(getActiveTrigger(wt.getMode(), wt.getParams()));
-
-            // how often they trigger has to be determined now as well, not only when they are put on the stack
-            for (final Trigger t : wt.getTriggers()) {
-                if (!t.isStatic()) {
-                    wt.setAdditionalTriggers(t, StaticAbilityPanharmonicon.countPanharmonicon(game, t, wt.getParams()));
-                }
-            }
+            collectWaitingTrigger(wt);
+        }
+    }
+
+    private void collectWaitingTrigger(TriggerWaiting waiting) {
+        waiting.setTriggers(getActiveTrigger(waiting.getMode(), waiting.getParams()));
+        for (Trigger trigger : waiting.getTriggers()) {
+            if (!trigger.isStatic()) {
+                waiting.setAdditionalTriggers(trigger,
+                        StaticAbilityPanharmonicon.countPanharmonicon(game, trigger, waiting.getParams()));
+            }
+        }
+    }
+
+    /** Hold the zone-change event for a tentative cast while mana abilities are resolving. */
+    public TriggerWaiting holdCastPlacement(Card card) {
+        for (int index = waitingTriggers.size() - 1; index >= 0; index--) {
+            TriggerWaiting waiting = waitingTriggers.get(index);
+            if (waiting.getMode() == TriggerType.ChangesZone
+                    && waiting.getParams().get(AbilityKey.Card) == card
+                    && ZoneType.Stack.name().equals(waiting.getParams().get(AbilityKey.Destination))) {
+                waitingTriggers.remove(index);
+                if (waiting.getTriggers() == null) {
+                    collectWaitingTrigger(waiting);
+                }
+                return waiting;
+            }
+        }
+        return null;
+    }
+
+    public void commitCastPlacement(TriggerWaiting waiting) {
+        if (waiting != null) {
+            waitingTriggers.add(waiting);
         }
     }
 

+    /** Preserve runtime cost state independently of printed text when copying a cast. */
+    public void copyCostModifiersFrom(final SpellAbility source) {
+        boolean hasModifier = false;
+        for (String parameter : List.of("ReduceCost", "ReduceAmount", "RaiseCost")) {
+            if (source.hasParam(parameter)) {
+                setCostModifier(parameter, source.getParam(parameter));
+                hasModifier = true;
+            }
+        }
+        if (hasModifier) {
+            // Expressions remain strings and evaluate against this ability's game.
+            // Include nested variables, each in a new map rather than the source's mutable map.
+            setSVars(source.getSVars());
+        }
+    }
+
+    /** Use the same granted reductions/increases in admission checks and live resolution. */
+    public void applyPlayEffectCostModifiers(final SpellAbility effect) {
+        if (effect.hasParam("PlayReduceCost")) {
+            String reduce = effect.getParam("PlayReduceCost");
+            setCostModifier("ReduceCost", reduce);
+            if (!StringUtils.isNumeric(reduce)) {
+                setSVar(reduce, effect.getSVar(reduce));
+            }
+        }
+        if (effect.hasParam("PlayRaiseCost")) {
+            setCostModifier("RaiseCost", effect.getParam("PlayRaiseCost"));
+        }
+    }
+
+    private void setCostModifier(final String parameter, final String value) {
+        mapParams.put(parameter, value);
+        originalMapParams.put(parameter, value);
     }
 

+            lost.add(java.util.Objects.requireNonNull(mapper.apply(player), "Unmapped lost player"));
+        }
+        ingamePlayers.clear();
+        ingamePlayers.addAll(active);
+        lostPlayers.clear();
+        lostPlayers.addAll(lost);

+    /** Preserve counter history in independent mapped receipts without repeating counter events. */
+    public void copySnapshotCounterHistoryFrom(Game original, IEntityMap map) {
+        Table<CounterType, Player, List<Pair<Card, Integer>>> copied = HashBasedTable.create();
+        for (Table.Cell<CounterType, Player, List<Pair<Card, Integer>>> cell : original.countersAddedThisTurn.cellSet()) {
+            List<Pair<Card, Integer>> receipts = new ArrayList<>();
+            for (Pair<Card, Integer> receipt : cell.getValue()) {
+                Card historical = CardCopyService.getLKICopyForGame(receipt.getKey(), map);
+                receipts.add(Pair.of(historical, receipt.getValue()));
+            }
+            copied.put(cell.getRowKey(), map.map(cell.getColumnKey()), receipts);
+        }
+        Multimap<CounterType, Pair<GameEntity, Integer>> removed = ArrayListMultimap.create();
+        for (Map.Entry<CounterType, Pair<GameEntity, Integer>> entry : original.countersRemovedThisTurn.entries()) {
+            Pair<GameEntity, Integer> receipt = entry.getValue();
+            GameEntity historical = receipt.getKey() instanceof Card card
+                    ? CardCopyService.getLKICopyForGame(card, map) : map.map(receipt.getKey());
+            removed.put(entry.getKey(), Pair.of(historical, receipt.getValue()));
+        }
+        countersAddedThisTurn = copied;
+        countersRemovedThisTurn = removed;
+    }

+    private Card temporaryCastCopy(Card source) {
+        Card result = Card.fromPaperCard(source.getPaperCard(), aiPlayer);
+        result.setGamePieceType(GamePieceType.TOKEN);
+        Card copiedFrom = source.isToken() ? source.getCopiedPermanent() : source;
+        if (copiedFrom != null) result.setCopiedPermanent(copier.find(copiedFrom));
+        Zone original = source.getZone();
+        Zone zone;
+        if (original == null) {
+            zone = aiPlayer.getZone(ZoneType.None);
+        } else if (original.getPlayer() == null) {
+            zone = simGame.getStackZone();
+        } else {
+            zone = copier.find(original.getPlayer()).getZone(original.getZoneType());
+        }
+        result.setZone(zone);
+        zone.add(result);
+        return result;
+    }

 import forge.util.Localizer;
 
 public class PeekAndRevealEffect extends SpellAbilityEffect {
+
+    @Override
+    public boolean canChooseOptionalAction(final SpellAbility sa) {
+        // Compound effects declare whether revealing is their optional primary action.
+        if (!sa.hasParam("NoPeek") || sa.hasParam("NoReveal") || sa.hasParam("RevealOptional")
+                || sa.hasParam("UnlessCost")
+                || (sa.getSubAbility() != null && !sa.hasParam("OptionalPrimaryReveal"))) {
+            return true;
+        }
+        final Card host = sa.getHostCard();
+        final Player peeker = sa.getActivatingPlayer();
+        final int amount = AbilityUtils.calculateAmount(host, sa.getParamOrDefault("PeekAmount", "1"), sa);
+        if (amount <= 0) {
+            return true;
+        }
+        final ZoneType zone = sa.hasParam("SourceZone")
+                ? ZoneType.smartValueOf(sa.getParam("SourceZone")) : ZoneType.Library;
+        for (Player owner : getDefinedPlayersOrTargeted(sa)) {
+            final PlayerZone cards = owner.getZone(zone);
+            final CardCollection candidates = new CardCollection();
+            for (int index = 0; index < Math.min(amount, cards.size()); index++) {
+                candidates.add(cards.get(index));
+            }
+            if (!CardLists.getValidCards(candidates, sa.getParamOrDefault("RevealValid", "Card"),
+                    peeker, host, sa).isEmpty()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
 

diff --git a/forge-ai/src/main/java/forge/ai/simulation/StackResponsePlanner.java b/forge-ai/src/main/java/forge/ai/simulation/StackResponsePlanner.java
new file mode 100644
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/simulation/StackResponsePlanner.java
@@ -0,0 +1,82 @@
+package forge.ai.simulation;
+
+import forge.ai.AiAbilityDecision;
+import forge.ai.AiPlayDecision;
+import forge.game.player.Player;
+import forge.game.spellability.AbilitySub;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+import forge.util.AITimeoutTracker;
+import forge.util.MyRandom;
+import java.util.Random;
+
+/** Bounded paired native outcomes for complete compound stack responses. */
+public final class StackResponsePlanner {
+    private static final ThreadLocal<Boolean> ASSESSING = ThreadLocal.withInitial(() -> false);
+    private static final long[] SEEDS = {0L, 4096L};
+    private static final int MAX_TARGET_CHOICES = 128;
+
+    private StackResponsePlanner() { }
+
+    public static boolean targetsStack(SpellAbility action) {
+        return action.usesTargeting() && action.getTargetRestrictions().getZone().contains(ZoneType.Stack);
+    }
+
+    public static AiAbilityDecision choose(Player actor, SpellAbility action) {
+        if (ASSESSING.get() || action instanceof AbilitySub || action.isTrigger()
+                || actor.getGame().getStack().isResolving() || !targetsStack(action)) {
+            return new AiAbilityDecision(0, AiPlayDecision.AnotherTime);
+        }
+        ASSESSING.set(true);
+        try {
+            return MyRandom.withRandom(new Random(0L), () -> assess(actor, action));
+        } finally {
+            ASSESSING.remove();
+        }
+    }
+
+    private static AiAbilityDecision assess(Player actor, SpellAbility action) {
+        GameStateEvaluator.Score[] baseline = new GameStateEvaluator.Score[SEEDS.length];
+        long baselineValue = 0;
+        long baselineAvailable = 0;
+        for (int i = 0; i < SEEDS.length; i++) {
+            final long seed = SEEDS[i];
+            baseline[i] = MyRandom.withRandom(new Random(seed),
+                    () -> GameSimulator.scoreForDecision(actor.getGame(), actor));
+            baselineValue += baseline[i].value;
+            baselineAvailable += baseline[i].availableValue;
+        }
+        SpellAbility trial = action.copy();
+        MultiTargetSelector selector = new MultiTargetSelector(trial, null);
+        SpellAbility best = null;
+        long bestValue = baselineValue;
+        for (int choice = 0; choice < MAX_TARGET_CHOICES && selector.selectNextTargets(); choice++) {
+            AITimeoutTracker.check();
+            long value = 0;
+            long available = 0;
+            boolean complete = true;
+            for (int i = 0; i < SEEDS.length; i++) {
+                final long seed = SEEDS[i];
+                final GameStateEvaluator.Score start = baseline[i];
+                GameStateEvaluator.Score result = MyRandom.withRandom(new Random(seed), () -> {
+                    GameSimulator simulator = new GameSimulator(new SimulationController(start, 0), actor.getGame(), actor, null);
+                    return simulator.simulateSpellAbility(trial);
+                });
+                if (result.value == Integer.MIN_VALUE) {
+                    complete = false;
+                    break;
+                }
+                value += result.value;
+                available += result.availableValue;
+            }
+            if (complete && value > bestValue && available > baselineAvailable) {
+                best = trial.copy();
+                bestValue = value;
+            }
+        }
+        if (best == null) return new AiAbilityDecision(0, AiPlayDecision.DoesntImpactGame);
+        for (SpellAbility part = action; part != null; part = part.getSubAbility()) part.resetTargets();
+        SpellAbilityChoiceCopier.copyTargets(best, action, object -> object);
+        return new AiAbilityDecision(100, AiPlayDecision.WillPlay);
+    }
+}
diff --git a/forge-ai/src/main/java/forge/ai/simulation/OptionalTriggerPlanner.java b/forge-ai/src/main/java/forge/ai/simulation/OptionalTriggerPlanner.java
new file mode 100644
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/simulation/OptionalTriggerPlanner.java
@@ -0,0 +1,49 @@
+package forge.ai.simulation;
+
+import forge.game.Game;
+import forge.game.ability.ApiType;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.trigger.WrappedAbility;
+import forge.util.MyRandom;
+import java.util.Random;
+
+/** Paired native suffixes at an exact optional-trigger resolution checkpoint. */
+public final class OptionalTriggerPlanner {
+    private static final ThreadLocal<Boolean> ASSESSING = ThreadLocal.withInitial(() -> false);
+
+    private OptionalTriggerPlanner() { }
+
+    public static Boolean choose(Player actor, WrappedAbility wrapper) {
+        Game game = actor.getGame();
+        SpellAbility action = wrapper.getWrappedAbility();
+        if (ASSESSING.get() || !game.getStack().isResolving()
+                || game.getStack().peekAbility() != wrapper || action.usesTargeting()
+                || action.getApi() != ApiType.ControlSpell || !"Exchange".equals(action.getParam("Mode"))) {
+            return null;
+        }
+        ASSESSING.set(true);
+        try {
+            Player beneficiary = DecisionPerspective.beneficiary(actor);
+            GameStateEvaluator.Score declined = project(game, actor, beneficiary, wrapper, false);
+            GameStateEvaluator.Score accepted = project(game, actor, beneficiary, wrapper, true);
+            return accepted.value > declined.value && accepted.availableValue > declined.availableValue;
+        } finally {
+            ASSESSING.remove();
+        }
+    }
+
+    private static GameStateEvaluator.Score project(Game source, Player actor, Player beneficiary,
+            WrappedAbility wrapper, boolean accepted) {
+        return MyRandom.withRandom(new Random(0L), () -> {
+            GameCopier copier = new GameCopier(source).withStack(true);
+            Game game = copier.makeCopy();
+            WrappedAbility copiedWrapper = copier.find(wrapper);
+            game.getStack().resumeOptionalTriggerCheckpoint(copiedWrapper, accepted);
+            Player copiedActor = copier.find(actor);
+            Player resolver = copiedActor.getWeakestOpponent();
+            GameSimulator.resolveStack(game, resolver == null ? copiedActor : resolver);
+            return new GameStateEvaluator().getScoreForGameState(game, copier.find(beneficiary));
+        });
+    }
+}

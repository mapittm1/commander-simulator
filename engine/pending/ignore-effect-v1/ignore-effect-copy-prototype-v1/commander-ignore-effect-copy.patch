+    /** Keep the effect identity and eligible entities local to each simulation world. */
+    private static final class IgnoreEffectAbility extends AbilityStatic {
+        private StaticAbility effect;
+        private List<Player> validActivators;
+        private CardCollectionView affectedCards;
+
+        private IgnoreEffectAbility(Card source, Cost cost, StaticAbility effect,
+                List<Player> validActivators, CardCollectionView affectedCards) {
+            super(source, cost, null);
+            this.effect = effect;
+            this.validActivators = validActivators;
+            this.affectedCards = affectedCards;
+        }
+
+        @Override
+        public void resolve() {
+            effect.addIgnoreEffectPlayers(getActivatingPlayer());
+            effect.setIgnoreEffectCards(affectedCards);
+        }
+
+        @Override
+        public boolean canPlay() {
+            return validActivators.contains(getActivatingPlayer()) && getHostCard().isInPlay();
+        }
+
+        @Override
+        protected void copySnapshotSubclassFieldsTo(SpellAbility target, SpellAbilitySnapshot context) {
+            IgnoreEffectAbility copy = (IgnoreEffectAbility) target;
+            copy.effect = context.staticAbility(effect);
+            copy.validActivators = new ArrayList<>();
+            for (Player player : validActivators) {
+                copy.validActivators.add(context.map(player));
+            }
+            copy.affectedCards = context.cards(affectedCards);
+        }
+    }
+
+    /** One callback identity is shared by the native turn and leaves-play queues. */
+    private static final class ClearIgnoreEffect implements SnapshotCommand {
+        private static final long serialVersionUID = -5415775215053216360L;
+        private final StaticAbility effect;
+
+        private ClearIgnoreEffect(StaticAbility effect) {
+            this.effect = effect;
+        }
+
+        @Override
+        public void run() {
+            effect.clearIgnoreEffects();
+        }
+
+        @Override
+        public GameCommand copyForSnapshot(SpellAbilitySnapshot context) {
+            return new ClearIgnoreEffect(context.staticAbility(effect));

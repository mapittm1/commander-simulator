+    /** Apply native activation limits to the uses already committed by a preview. */
+    private static boolean hasProjectedActivationRemaining(final SpellAbility ability,
+            final List<SpellAbility> paymentList) {
+        final String turnLimit = ability.getRestrictions().getLimitToCheck();
+        final String gameLimit = ability.getRestrictions().getGameLimitToCheck();
+        final boolean turnKeyword = ability.isBoast();
+        final boolean gameKeyword = ability.isExhaust() || ability.isPowerUp();
+        if (turnLimit == null && gameLimit == null && !turnKeyword && !gameKeyword) {
+            return true;
+        }
+        // ActivationTable preserves the engine's original-ability and static-grantor grouping.
+        final ActivationTable projected = new ActivationTable();
+        for (final SpellAbility used : paymentList) projected.add(used);
+        final int planned = projected.get(ability);
+        final long turnUsed = (long) ability.getActivationsThisTurn() + planned;
+        final long gameUsed = (long) ability.getActivationsThisGame() + planned;
+        final Card host = ability.getHostCard();
+        if (turnLimit != null && turnUsed >= AbilityUtils.calculateAmount(host, turnLimit, ability)) {
+            return false;
+        }
+        if (gameLimit != null && gameUsed >= AbilityUtils.calculateAmount(host, gameLimit, ability)) {
+            return false;
+        }
+        if (turnKeyword || gameKeyword) {
+            final int limit = StaticAbilityAdditionalActivations.getLimit(host, ability, ability.getActivatingPlayer());
+            if ((turnKeyword ? turnUsed : gameUsed) >= limit) return false;
+        }
+        return true;
+    }
+
+    /** Repeated color conversion consumes finite generic mana and cannot project a tap twice. */
+    private static boolean isRepeatableColorFilter(final SpellAbility ability, final ManaCostShard shard) {
+        if (shard == ManaCostShard.GENERIC || shard == ManaCostShard.X
+                || !isNonIncreasingManaFilter(ability) || !isFilterManaAbility(ability)
+                || !getManaCostToActivate(ability).isPureGeneric()) {
+            return false;
+        }
+        for (final CostPart part : ability.getPayCosts().getCostParts()) {
+            if (!(part instanceof CostPartMana)) return false;
+        }
+        return true;
+    }
+
     private static int getManaToActivate(final SpellAbility ma) {
         final ManaCost manaCost = getManaCostToActivate(ma);
         return manaCost == null ? 0 : manaCost.getCMC();

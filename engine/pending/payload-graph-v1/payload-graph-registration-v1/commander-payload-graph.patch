+    /** Preserve mutable event-payload identity; native field-owned copies stay separate. */
+    private <T> T rememberPayload(Object source, T target) {
+        if (payloadCopies == null) {
+            payloadCopies = new ArrayList<>();
+        }
+        payloadCopies.add(source);
+        objects.put(source, target);
+        return target;
+    }

+    private static final int MAX_FORECAST_STACK_RESOLUTIONS = 64;
+
+    /**
+     * Execute the native cast/target/cost-trigger segment, stopping before the forecast goal resolves.
+     * Native resolution preserves full costs, controller choices, trigger order and state-based actions.
+     * A bounded unsuccessful observation is not proof that every possible payment is impossible.
+     */
+    private static boolean resolveBeforeForecastGoal(Game game, SpellAbility goal) {
+        if (game.getStack().getInstanceMatchingSpellAbilityID(goal) == null) game.getStack().add(goal);
+        Set<Card> affected = new HashSet<>();
+        for (int resolved = 0; resolved <= MAX_FORECAST_STACK_RESOLUTIONS; resolved++) {
+            game.getAction().checkStateEffects(false, affected);
+            game.getStack().addAllTriggeredAbilitiesToStack();
+            if (game.isGameOver() || game.getStack().getInstanceMatchingSpellAbilityID(goal) == null) return false;
+            if (game.getStack().peekAbility().getId() == goal.getId()) return true;
+            if (resolved == MAX_FORECAST_STACK_RESOLUTIONS) return false;
+            game.getStack().resolveStack();
+        }
+        return false;
     }
 

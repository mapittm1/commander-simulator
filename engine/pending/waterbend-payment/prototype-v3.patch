+    /** Choose waterbend taps only when the remaining mana has an independent payment. */
+    private Map<Card, ManaCostShard> chooseWaterbendPayment(SpellAbility sa, ManaCost manaCost,
+            CardCollectionView candidates, Integer maxReduction) {
+        CardCollection ordered = new CardCollection(candidates);
+        ordered.sort(Comparator.comparing((Card card) -> !card.getManaAbilities().isEmpty())
+                .thenComparing(Card::isCreature));
+        int maximum = maxReduction == null ? manaCost.getGenericCost()
+                : Math.min(manaCost.getGenericCost(), Math.max(0, maxReduction));
+        maximum = Math.min(maximum, ordered.size());
+        for (int amount = maximum; amount > 0; amount--) {
+            Map<Card, ManaCostShard> chosen = ComputerUtilMana.getConvokeOrImproviseFromList(
+                    ManaCost.get(amount), ordered, true, true);
+            ManaCostBeingPaid remaining = new ManaCostBeingPaid(manaCost);
+            remaining.decreaseGenericMana(chosen.size());
+            if (ComputerUtilMana.canPayManaCostWithReservedCards(remaining, sa,
+                    sa.getActivatingPlayer(), false, chosen.keySet())) {
+                return chosen;
+            }
+        }
+        return Collections.emptyMap();
+    }

+    /** Bounded native search is an observation of a found plan, never an impossibility certificate. */
+    private static FilterPlan findFilterPlan(ManaCostBeingPaid cost, SpellAbility goal, Player payer,
+            boolean effect, List<FilterSource> sources) {
+        ArrayDeque<FilterNode> queue = new ArrayDeque<>();
+        queue.add(filterCopy(new FilterNode(payer.getGame(), payer, goal, List.of())));
+        int copies = 1;
+        while (!queue.isEmpty() && copies <= 64) {
+            FilterNode node = queue.removeFirst();
+            prepareManaPoolForPayment(node.payer(), node.goal(), effect);
+            ManaCostBeingPaid remaining = new ManaCostBeingPaid(cost);
+            if (filterPoolCovers(remaining, node.goal(), node.payer())) {
+                return new FilterPlan(node.steps(), remaining);
+            }
+            if (node.steps().size() >= Math.min(32, sources.size() * 2 + 2)) continue;
+            for (FilterSource source : sources) {
+                SpellAbility mapped = source.find(node.game());
+                if (mapped == null) continue;
+                mapped.setActivatingPlayer(node.payer());
+                for (String choice : filterChoices(mapped)) {
+                    if (copies >= 64) break;
+                    FilterNode child = filterCopy(node);
+                    copies++;
+                    FilterStep step = new FilterStep(source, choice);
+                    if (!activateFilterStep(step, child.game(), child.payer(), effect)) continue;
+                    List<FilterStep> steps = new ArrayList<>(node.steps());
+                    steps.add(step);
+                    queue.addLast(new FilterNode(child.game(), child.payer(), child.goal(), List.copyOf(steps)));
+                }
+            }
+        }
+        return null;
+    }

+    /** A false probe refunds partial pool debits too; native true probes already refund themselves. */
+    private static boolean filterPoolCovers(ManaCostBeingPaid cost, SpellAbility ability, Player payer) {
+        List<Mana> spent = new ArrayList<>();
+        boolean paid = payer.getManaPool().payManaCostFromPool(cost, ability, true, spent);
+        if (!paid) payer.getManaPool().refundMana(spent);
+        return paid;
+    }

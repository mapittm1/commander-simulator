+    private static boolean activateFilterStep(FilterStep step, Game game, Player payer, boolean effect) {
+        SpellAbility ability = step.source().find(game);
+        if (ability == null) return false;
+        ability.setActivatingPlayer(payer);
+        prepareManaPoolForPayment(payer, ability, effect);
+        ManaCostBeingPaid activation = calculateManaCost(ability.getPayCosts(), ability, payer, true, 0, effect);
+        if (!filterPoolCovers(activation, ability, payer) || !ability.canPlay()) return false;
+        ability.getManaPart().setExpressChoice(step.choice());
+        boolean newTap = rememberManaTap(payer, ability);
+        if (!new CostPayment(ability.getPayCosts(), ability).payComputerCosts(new AiCostDecision(payer, ability, effect, true))) {
+            releaseFailedManaTap(payer, ability, newTap);
+            return false;
+        }
+        game.getStack().addAndUnfreeze(ability);
+        return true;
+    }

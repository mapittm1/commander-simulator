+    private record FilterSource(SpellAbility original, int index) {
+        SpellAbility find(Game game) {
+            for (Card card : game.getCardsInGame()) {
+                if (card.getId() != original.getHostCard().getId()) continue;
+                List<SpellAbility> abilities = card.getManaAbilities();
+                if (index >= abilities.size()) return null;
+                SpellAbility found = abilities.get(index);
+                return found.getMapParams().equals(original.getMapParams())
+                        && found.getPayCosts().toString().equals(original.getPayCosts().toString()) ? found : null;
+            }
+            return null;
+        }
+    }
+    private record FilterStep(FilterSource source, String choice) { }
+    private record FilterNode(Game game, Player payer, SpellAbility goal, List<FilterStep> steps) { }
+    private record FilterPlan(List<FilterStep> steps, ManaCostBeingPaid paidCost) { }

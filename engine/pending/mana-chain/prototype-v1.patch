+    private static List<SpellAbility> payManaCost(final ManaCostBeingPaid cost, final SpellAbility sa,
+            final Player ai, final boolean test, boolean checkPlayable, boolean effect,
+            Set<Card> reservedCards, boolean checkSacrificeValue) {
+        boolean plainGoal = !sa.isManaAbility() && !sa.isOffering() && !sa.isEmerge()
+                && sa.getPayCosts() != null
+                && sa.getPayCosts().getCostParts().stream().allMatch(CostPartMana.class::isInstance);
+        List<FilterSource> sources = plainGoal ? filterSearchSources(ai, reservedCards) : List.of();
+        if (sources.isEmpty()) return payManaCostGreedy(cost, sa, ai, test, checkPlayable, effect, reservedCards, checkSacrificeValue);
+        ManaCostBeingPaid initial = new ManaCostBeingPaid(cost);
+        List<SpellAbility> greedy = test
+                ? payManaCostGreedy(cost, sa, ai, true, checkPlayable, effect, reservedCards, checkSacrificeValue)
+                : previewManaPayment(cost, sa, ai, effect, reservedCards, checkSacrificeValue, false);
+        if (greedy != null) return test ? greedy
+                : payManaCostGreedy(cost, sa, ai, false, checkPlayable, effect, reservedCards, checkSacrificeValue);
+        adjustManaCostToAvoidNegEffects(initial, sa.getHostCard(), ai);
+        FilterPlan plan = findFilterPlan(initial, sa, ai, effect, sources);
+        if (plan == null) return test ? null
+                : payManaCostGreedy(cost, sa, ai, false, checkPlayable, effect, reservedCards, checkSacrificeValue);
+        if (test) {
+            Set<ManaCostBeingPaid> unpaid = AiCardMemory.getMemorySet(ai, AiCardMemory.MemorySetMana.UNPAID_COSTS);
+            if (unpaid != null) unpaid.remove(cost);
+            cost.copyFrom(plan.paidCost());
+            return plan.steps().stream().map(step -> step.source().original()).collect(Collectors.toList());
+        }
+        List<SpellAbility> payments = new ArrayList<>();
+        for (FilterStep step : plan.steps()) {
+            if (!activateFilterStep(step, ai.getGame(), ai, effect)) break;
+            payments.add(step.source().original());
+        }
+        prepareManaPoolForPayment(ai, sa, effect);
+        List<Mana> spent = sa.getPayingMana();
+        if (ai.getManaPool().payManaCostFromPool(cost, sa, false, spent)) {
+            CostPayment.handleOfferings(sa, false, true);
+            return payments;
+        }
+        ai.getManaPool().refundMana(spent);
+        List<SpellAbility> rest = payManaCostGreedy(cost, sa, ai, false, checkPlayable, effect, reservedCards, checkSacrificeValue);
+        if (rest == null) return null;
+        payments.addAll(rest);
+        return payments;
+    }

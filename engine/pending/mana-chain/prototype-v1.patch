+    private static List<String> filterChoices(SpellAbility ability) {
+        AbilityManaPart part = ability.getManaPart();
+        if (!part.isAnyMana() && !part.isComboMana()) return List.of("");
+        List<String> colors = new ArrayList<>();
+        for (byte color : ManaAtom.MANATYPES) {
+            String symbol = MagicColor.toShortString(color);
+            if (part.canProduce(symbol, ability)) colors.add(symbol);
+        }
+        if (!part.isComboMana()) return colors;
+        int amount = ability.amountOfManaGenerated(false);
+        if (amount <= 0 || amount > 8) return List.of();
+        List<String> choices = new ArrayList<>();
+        addFilterChoices(colors, amount, 0, new ArrayList<>(), choices);
+        return choices;
+    }
+
+    private static void addFilterChoices(List<String> colors, int left, int first,
+            List<String> selected, List<String> choices) {
+        if (choices.size() >= 64) return;
+        if (left == 0) { choices.add(String.join(" ", selected)); return; }
+        for (int index = first; index < colors.size(); index++) {
+            selected.add(colors.get(index));
+            addFilterChoices(colors, left - 1, index, selected, choices);
+            selected.remove(selected.size() - 1);
+        }
+    }

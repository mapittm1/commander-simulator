+    /** Plain sources only; native cost/effect execution supplies legality inside each isolated node. */
+    private static List<FilterSource> filterSearchSources(Player payer, Set<Card> reservedCards) {
+        List<FilterSource> result = new ArrayList<>();
+        int paidFilters = 0;
+        boolean coloredActivation = false;
+        for (Card card : CardCollection.combine(payer.getCardsIn(ZoneType.Battlefield),
+                payer.getCardsIn(ZoneType.Hand), payer.getCardsIn(ZoneType.Command))) {
+            List<SpellAbility> abilities = card.getManaAbilities();
+            for (int index = 0; index < abilities.size(); index++) {
+                SpellAbility ability = abilities.get(index);
+                Cost pay = ability.getPayCosts();
+                if (ability.getApi() != ApiType.Mana || ability.getSubAbility() != null || pay == null
+                        || ability.getGrantorStatic() != null || ability.getManaPart() == null
+                        || ability.getManaPart().isSpecialMana()
+                        || ability.getManaPart().getOrigProduced().contains("Chosen")
+                        || pay.getCostParts().stream().anyMatch(part -> !(part instanceof CostPartMana) && !(part instanceof CostTap))
+                        || pay.hasTapCost() && (card.isTapped() || reservedCards.contains(card))) continue;
+                int activation = getManaToActivate(ability);
+                if (activation > 0) {
+                    if (!isFilterManaAbility(ability)) continue;
+                    paidFilters++;
+                    coloredActivation |= !getManaCostToActivate(ability).isPureGeneric();
+                }
+                result.add(new FilterSource(ability, index));
+            }
+        }
+        return paidFilters > 1 || coloredActivation ? result : List.of();
+    }

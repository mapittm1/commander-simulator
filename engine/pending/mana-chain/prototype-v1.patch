+    private static FilterNode filterCopy(FilterNode parent) {
+        GameCopier copier = new GameCopier(parent.game()).withStack(true);
+        Game game = copier.makeCopy(null, parent.payer());
+        Player payer = copier.find(parent.payer());
+        SpellAbility goal = copier.find(parent.goal());
+        copier.release();
+        return new FilterNode(game, payer, goal, parent.steps());
+    }

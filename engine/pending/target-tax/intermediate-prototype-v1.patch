+        Game copy = copier.makeCopy(null, payer);
+        Player copiedPayer = copier.find(payer);
+        SpellAbility goal = copier.find(ability);
+        Cost copiedCost = copier.findCost(cost);
+        // Native execution must retain the source-selection policy of the original forecast.
+        for (MemorySet set : List.of(MemorySet.HELD_MANA_SOURCES_FOR_MAIN2,
+                MemorySet.HELD_MANA_SOURCES_FOR_DECLBLK, MemorySet.HELD_MANA_SOURCES_FOR_ENEMY_DECLBLK,
+                MemorySet.HELD_MANA_SOURCES_FOR_NEXT_SPELL, MemorySet.PAYS_TAP_COST, MemorySet.PAYS_SAC_COST)) {
+            Set<Card> remembered = AiCardMemory.getMemorySet(payer, set);
+            if (remembered == null) continue;
+            for (Card original : remembered) {
+                Card live = payer.getGame().getCardState(original);
+                if (live != null && live.equalsWithGameTimestamp(original)) {
+                    AiCardMemory.rememberCard(copiedPayer, copier.find(live), set);
+                }
+            }
+        }
+        Set<ManaCostBeingPaid> unpaid = AiCardMemory.getMemorySet(payer, AiCardMemory.MemorySetMana.UNPAID_COSTS);
+        Set<ManaCostBeingPaid> copiedUnpaid = AiCardMemory.getMemorySet(copiedPayer, AiCardMemory.MemorySetMana.UNPAID_COSTS);
+        if (unpaid != null && copiedUnpaid != null) {
+            for (ManaCostBeingPaid remainder : unpaid) copiedUnpaid.add(new ManaCostBeingPaid(remainder));
+        }
+        copier.release();
+        TriggerWaiting placement = null;
+        if (goal.isSpell() && !goal.getHostCard().isInZone(ZoneType.Stack)) {
+            Card onStack = copy.getAction().moveToStack(goal.getHostCard(), goal);
+            if (includeWard) placement = copy.getTriggerHandler().holdCastPlacement(onStack);
+            goal.setHostCard(onStack);
+        }
+        if (!new CostPayment(copiedCost, goal).payComputerCosts(new AiCostDecision(copiedPayer, goal, effect, true))) {
+            return false;
+        }
+        if (includeWard) {
+            if (placement != null) copy.getTriggerHandler().commitCastPlacement(placement);
+            if (!resolveBeforeForecastGoal(copy, goal)) return false;
+        } else if (!goal.isCopied()) {
+            goal.applyPayingManaEffects();
+        }
+        if (extraMana == 0) return true;
+        // A separate triggered payment is not casting the original spell. Cast-only mana cannot pay it.
+        SpellAbility separate = AbilityFactory.getAbility("DB$ Draw | NumCards$ 0", goal.getHostCard());
+        separate.setActivatingPlayer(copiedPayer);
+        Cost budget = new Cost(ManaCost.get(extraMana), false);
+        return new CostPayment(budget, separate).payComputerCosts(new AiCostDecision(copiedPayer, separate, true, true));
+    }

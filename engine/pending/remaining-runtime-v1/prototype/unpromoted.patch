+    /** Select without temporary edition lists/maps; unknown metadata keeps the native path. */
+    private PaperCard selectNativePrinting(final List<PaperCard> cards, final CardArtPreference preference) {
+        if (editions.getClass() != CardEdition.Collection.class) return null;
+        for (PaperCard card : cards) {
+            if (card.getClass() != PaperCard.class) return null;
+        }
+        CardEdition bestAny = null;
+        CardEdition bestAccepted = null;
+        PaperCard anyCard = null;
+        PaperCard acceptedCard = null;
+        for (PaperCard card : cards) {
+            final String code = card.getEdition();
+            final CardEdition edition = code.equals(CardEdition.UNKNOWN_CODE)
+                    ? CardEdition.UNKNOWN : editions.get(code);
+            if (edition == null) continue;
+            if (edition.getClass() != CardEdition.class || !code.equals(edition.getCode())) return null;
+            if (bestAny == null || precedesEdition(edition, bestAny, preference)) {
+                bestAny = edition;
+                anyCard = card;
+            } else if (code.equals(bestAny.getCode())) {
+                anyCard = card; // Native candidate map keeps the last printing in the winning edition.
+            }
+            if (!preference.accept(edition)) continue;
+            if (bestAccepted == null || precedesEdition(edition, bestAccepted, preference)) {
+                bestAccepted = edition;
+                acceptedCard = card;
+            } else if (code.equals(bestAccepted.getCode())) {
+                acceptedCard = card;
+            }
+        }
+        return bestAccepted == null ? anyCard : acceptedCard;
+    }
+
+    /** Match stable rank sorting after native date/name sorting and optional reversal. */
+    private static boolean precedesEdition(final CardEdition candidate, final CardEdition current,
+            final CardArtPreference preference) {
+        if (preference.blackBorderOnly) {
+            final int rank = Integer.compare(preference.getEditionRank(candidate), preference.getEditionRank(current));
+            if (rank != 0) return rank < 0;
+        }
+        final int order = candidate.compareTo(current);
+        // Reversing the stable native order makes the last equal item win for latest-first.
+        return preference.latestFirst ? order >= 0 : order < 0;
     }
 
